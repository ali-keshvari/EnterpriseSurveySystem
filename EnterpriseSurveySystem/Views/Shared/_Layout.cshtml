<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - سامانه جامع نظرسنجی و ارزیابی سازمانی (پرسش‌نما)</title>

    <!-- 100% Local Bootstrap 5.3.3 RTL & Custom Styles -->
    <link href="~/Content/bootstrap/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/Content/app-bootstrap.css" rel="stylesheet" />
</head>
<body>

    <!-- Sidebar (Right) -->
    <aside class="app-sidebar" id="appSidebar">
        <div>
            <!-- Brand -->
            <div class="d-flex align-items-center gap-2 pb-3 mb-3 border-bottom">
                <div class="stat-icon bg-primary text-white shadow-sm" style="width: 2.75rem; height: 2.75rem;">
                    <i class="bi bi-clipboard2-check fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark">پرسش‌نما</h5>
                    <small class="text-muted">مدیریت نظرسنجی سازمانی</small>
                </div>
            </div>

            <!-- Active Organization Badge -->
            <div class="p-2 mb-3 bg-light rounded-3 border d-flex align-items-center gap-2">
                <i class="bi bi-building text-primary fs-5"></i>
                <div class="overflow-hidden">
                    <small class="text-muted d-block" style="font-size: 0.75rem;">سازمان فعال</small>
                    <span class="fw-bold text-dark text-truncate d-block" style="font-size: 0.85rem;">شرکت توسعه داروسازی دکتر عبیدی</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="nav flex-column">
                <a href="@Url.Action("Index", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-speedometer2 fs-5"></i>
                    <span>داشبورد و آمار کل</span>
                </a>
                <a href="@Url.Action("Create", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Create" ? "active" : "")">
                    <i class="bi bi-file-earmark-plus fs-5"></i>
                    <span>سازنده فرم و سوالات</span>
                </a>
                <a href="@Url.Action("AuditLogs", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "AuditLogs" ? "active" : "")">
                    <i class="bi bi-shield-check fs-5"></i>
                    <span>لاگ‌های امنیتی (Audit)</span>
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer -->
        <div class="pt-3 border-top">
            <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3 border">
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-center" style="width: 2.25rem; height: 2.25rem;">
                    <i class="bi bi-person-fill fs-5 m-auto"></i>
                </div>
                <div class="overflow-hidden">
                    <span class="fw-bold d-block text-truncate" style="font-size: 0.85rem;">راهبر ارشد نظرسنجی</span>
                    <small class="text-success" style="font-size: 0.75rem;"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> برخط و متصل</small>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="app-main">
        <!-- Top Navbar -->
        <header class="bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between sticky-top shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('appSidebar').classList.toggle('show')">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="d-none d-md-block">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-shield-lock-fill me-1"></i> دیتابیس متصل (Database-First)
                    </span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Create", "Admin")" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-3">
                    <i class="bi bi-plus-lg"></i>
                    <span>پرسش‌نامه جدید</span>
                </a>
            </div>
        </header>

        <!-- Body Content -->
        <main class="flex-grow-1 p-3 p-md-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="bg-white border-top py-3 px-4 text-center text-muted" style="font-size: 0.85rem;">
            سامانه جامع مدیریت نظرسنجی و ارزیابی سازمانی &copy; @DateTime.Now.Year - تمام حقوق محفوظ است.
        </footer>
    </div>

    <!-- 100% Local jQuery & Bootstrap 5 Bundle JS -->
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
