<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - سامانه جامع نظرسنجی و ارزیابی سازمانی</title>

    <!-- 100% Local Bootstrap 5.3.3 RTL & Custom Styles -->
    <link href="~/Content/bootstrap/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/Content/app-bootstrap.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
</head>
<body>

    <!-- Sidebar (Right) -->
    <aside class="app-sidebar" id="appSidebar">
        <div>
            <!-- Organization Header -->
            <div class="d-flex align-items-center gap-2 pb-3 mb-3 border-bottom">
                <div class="stat-icon bg-primary text-white shadow-sm" style="width: 2.75rem; height: 2.75rem;">
                    <i class="bi bi-building fs-4"></i>
                </div>
                <div class="overflow-hidden">
                    <span class="fw-bold text-dark text-truncate d-block" style="font-size: 0.95rem;">داروسازی دکتر عبیدی</span>
                    <small class="text-muted d-block" style="font-size: 0.75rem;">سامانه نظرسنجی سازمانی</small>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="nav flex-column">
                <a href="@Url.Action("Index", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-speedometer2 fs-5"></i>
                    <span>داشبورد و آمار کل</span>
                </a>
                <a href="@Url.Action("Create", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Create" ? "active" : "")">
                    <i class="bi bi-file-earmark-plus fs-5"></i>
                    <span>سازنده فرم و سوالات</span>
                </a>
                <a href="@Url.Action("AuditLogs", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "AuditLogs" ? "active" : "")">
                    <i class="bi bi-shield-check fs-5"></i>
                    <span>لاگ‌های امنیتی (Audit)</span>
                </a>
            </nav>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="app-main">
        <!-- Top Navbar -->
        <header class="bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between sticky-top shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('appSidebar').classList.toggle('show')">
                    <i class="bi bi-list fs-5"></i>
                </button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Create", "Admin")" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-3">
                    <i class="bi bi-plus-lg"></i>
                    <span>پرسش‌نامه جدید</span>
                </a>
            </div>
        </header>

        <!-- Body Content -->
        <main class="flex-grow-1 p-3 p-md-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- 100% Local jQuery & Bootstrap 5 Bundle JS -->
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
