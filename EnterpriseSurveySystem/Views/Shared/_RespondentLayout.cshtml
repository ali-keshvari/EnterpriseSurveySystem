<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - نظرسنجی سازمانی</title>

    <!-- 100% Local Bootstrap 5.3.3 RTL & Custom Styles -->
    <link href="~/Content/bootstrap/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/Content/app-bootstrap.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <!-- Top Simple Header -->
    <header class="bg-white border-bottom py-3 shadow-sm sticky-top">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon bg-primary text-white" style="width: 2.25rem; height: 2.25rem; font-size: 1.25rem;">
                    <i class="bi bi-clipboard2-check"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">پرسش‌نما</h6>
                    <small class="text-muted" style="font-size: 0.75rem;">سامانه پاسخ‌دهی به نظرسنجی سازمانی</small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                    <i class="bi bi-shield-check me-1"></i> بستر پاسخ‌دهی امن و محرمانه
                </span>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="py-4 py-md-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="text-center py-4 text-muted border-top bg-white mt-auto" style="font-size: 0.85rem;">
        اطلاعات و پاسخ‌های ارسالی به صورت کاملاً رمزنگاری‌شده و محرمانه ثبت می‌گردند.
    </footer>

    <!-- 100% Local Bootstrap 5 Bundle JS -->
    <script src="~/Scripts/bootstrap/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
