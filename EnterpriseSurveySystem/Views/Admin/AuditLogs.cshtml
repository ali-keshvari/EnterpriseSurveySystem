@model EnterpriseSurveySystem.Models.ViewModels.AuditLogFilterViewModel
@{
    ViewBag.Title = "لاگ‌های زمانی و گزارش‌های امنیتی";
}

<div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-surface-container-high">
        <div>
            <div class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant mb-1">
                <a href="@Url.Action("Index", "Admin")" class="hover:text-primary transition">داشبورد</a>
                <span>/</span>
                <span>لاگ‌های زمانی</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg font-bold text-on-surface">سامانه ثبت وقایع و لاگ‌های زمانی (Audit Trail)</h1>
            <p class="font-label-sm text-label-sm text-on-surface-variant mt-1">پایش امنیتی ورودها، انقضای تایمرها، تراکنش‌ها و آی‌پی مخاطبان</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-surface-container-lowest border border-surface-container rounded-2xl p-5 shadow-sm">
        <form method="get" action="@Url.Action("AuditLogs", "Admin")" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">فیلتر بر اساس پرسش‌نامه</label>
                <select name="questionnaireId" class="w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high bg-surface-container-lowest text-on-surface">
                    <option value="">همه پرسش‌نامه‌ها</option>
                    @foreach (var q in Model.Questionnaires)
                    {
                        <option value="@q.Id" @(Model.QuestionnaireId == q.Id ? "selected" : "")>@q.Title</option>
                    }
                </select>
            </div>

            <div>
                <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">نوع عملیات امنیتی</label>
                <select name="actionType" class="w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high bg-surface-container-lowest text-on-surface">
                    <option value="">همه عملیات‌ها</option>
                    <option value="PageOpened" @(Model.ActionType == "PageOpened" ? "selected" : "")>ورود به پرسش‌نامه (PageOpened)</option>
                    <option value="FormSubmitted" @(Model.ActionType == "FormSubmitted" ? "selected" : "")>ثبت نهایی فرم (FormSubmitted)</option>
                    <option value="TokenExpired" @(Model.ActionType == "TokenExpired" ? "selected" : "")>انقضای مهلت (TokenExpired)</option>
                    <option value="TokensGenerated" @(Model.ActionType == "TokensGenerated" ? "selected" : "")>تولید توکن‌ها (TokensGenerated)</option>
                    <option value="AccessDenied" @(Model.ActionType == "AccessDenied" ? "selected" : "")>دسترسی غیرمجاز (AccessDenied)</option>
                </select>
            </div>

            <div class="flex items-end gap-2">
                <button type="submit" class="inline-flex items-center gap-1.5 bg-primary-container text-on-primary hover:bg-primary font-label-md text-label-md font-semibold px-5 py-2.5 rounded-xl shadow-sm transition">
                    <span class="material-symbols-outlined text-sm">filter_alt</span>
                    <span>اعمال فیلتر</span>
                </button>
                <a href="@Url.Action("AuditLogs", "Admin")" class="inline-flex items-center gap-1 text-on-surface hover:bg-surface-container-high font-label-md text-label-md px-3.5 py-2.5 rounded-xl border border-surface-container transition">
                    <span>پاکسازی</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Logs Table -->
    <div class="bg-surface-container-lowest border border-surface-container rounded-2xl shadow-sm overflow-hidden">
        <div class="p-5 sm:px-6 border-b border-surface-container-high flex items-center justify-between">
            <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">رویدادهای ثبت‌شده در دیتابیس</h2>
            <span class="font-label-sm text-label-sm text-on-surface-variant">تعداد رویدادها: @Model.Logs.Count</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right font-body-sm text-body-sm border-collapse">
                <thead class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md border-b border-surface-container-high">
                    <tr>
                        <th class="py-3.5 px-6 font-semibold">زمان دقیق رویداد</th>
                        <th class="py-3.5 px-4 font-semibold">نوع عملیات</th>
                        <th class="py-3.5 px-4 font-semibold">آدرس IP</th>
                        <th class="py-3.5 px-4 font-semibold">توکن / پرسش‌نامه</th>
                        <th class="py-3.5 px-6 font-semibold">جزئیات و شرح واقعه</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container text-on-surface">
                    @if (Model.Logs.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-on-surface-variant font-body-md">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <span class="material-symbols-outlined text-3xl text-outline-variant">history_toggle_off</span>
                                    <span>لاگی با مشخصات انتخابی یافت نشد.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model.Logs)
                        {
                            <tr class="hover:bg-surface-container-low/40 transition">
                                <td class="py-3.5 px-6 text-on-surface font-mono text-xs tabular-nums whitespace-nowrap">
                                    @log.Timestamp.ToString("yyyy/MM/dd HH:mm:ss")
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    @switch (log.ActionType)
                                    {
                                        case "PageOpened":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-surface-container-high text-primary border border-surface-container">
                                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                                <span>ورود اولیه به فرم</span>
                                            </span>
                                            break;
                                        case "FormSubmitted":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-tertiary-container/15 text-tertiary border border-tertiary-container/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                                                <span>ثبت نهایی پاسخ‌ها</span>
                                            </span>
                                            break;
                                        case "TokenExpired":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-error-container/20 text-error border border-error-container">
                                                <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                                                <span>انقضای مهلت لینک</span>
                                            </span>
                                            break;
                                        case "TokensGenerated":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-primary-container/10 text-primary border border-primary-container/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                                <span>تولید توکن‌ها</span>
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-surface-container text-on-surface border border-surface-container-high">
                                                <span>@log.ActionPersianTitle</span>
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-on-surface font-mono text-xs">@log.IPAddress</td>
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrEmpty(log.TokenGuid))
                                    {
                                        <span class="font-mono text-on-surface text-xs">@log.TokenGuid</span>
                                    }
                                    else if (!string.IsNullOrEmpty(log.QuestionnaireTitle))
                                    {
                                        <span class="text-on-surface font-label-md text-label-md">@log.QuestionnaireTitle</span>
                                    }
                                    else
                                    {
                                        <span class="text-on-surface-variant text-xs">-</span>
                                    }
                                </td>
                                <td class="py-3.5 px-6 text-on-surface-variant font-body-sm text-body-sm leading-relaxed">@log.Details</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
