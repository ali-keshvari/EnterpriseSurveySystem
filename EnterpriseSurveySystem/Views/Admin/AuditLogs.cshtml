@model EnterpriseSurveySystem.Models.ViewModels.AuditLogFilterViewModel
@{
    ViewBag.Title = "لاگ‌های زمانی و گزارش‌های امنیتی (Audit Trail)";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <h4 class="fw-bold mb-1 text-dark">رویدادنگاری تفصیلی و لاگ‌های امنیتی (Audit Trail)</h4>
            <p class="text-muted mb-0 small">ثبت خودکار و لحظه‌ای تمامی ورودها، بازگشایی لینک‌ها، مهلت‌های زمانی و ثبت پاسخ‌ها</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-arrow-right"></i>
                <span>بازگشت به داشبورد</span>
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card card-custom mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("AuditLogs", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-12 col-md-5">
                    <label class="form-label small fw-bold">فیلتر پرسش‌نامه</label>
                    <select name="questionnaireId" class="form-select form-select-sm">
                        <option value="">-- همه پرسش‌نامه‌ها --</option>
                        @foreach (var q in Model.Questionnaires)
                        {
                            <option value="@q.Id" @(Model.QuestionnaireId == q.Id ? "selected" : "")>@q.Title</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold">نوع رویداد</label>
                    <select name="actionType" class="form-select form-select-sm">
                        <option value="">-- همه انواع رویدادها --</option>
                        <option value="PageOpened" @(Model.ActionType == "PageOpened" ? "selected" : "")>ورود اولیه و بازگشایی (PageOpened)</option>
                        <option value="FormSubmitted" @(Model.ActionType == "FormSubmitted" ? "selected" : "")>ثبت نهایی پاسخ‌ها (FormSubmitted)</option>
                        <option value="TokenExpired" @(Model.ActionType == "TokenExpired" ? "selected" : "")>انقضای مهلت پاسخ‌گویی (TokenExpired)</option>
                        <option value="TokensGenerated" @(Model.ActionType == "TokensGenerated" ? "selected" : "")>صدور لینک‌های جدید (TokensGenerated)</option>
                        <option value="AccessDenied" @(Model.ActionType == "AccessDenied" ? "selected" : "")>رد دسترسی غیرمجاز (AccessDenied)</option>
                    </select>
                </div>

                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-funnel"></i>
                        <span>اعمال فیلتر</span>
                    </button>
                    <a href="@Url.Action("AuditLogs", "Admin")" class="btn btn-sm btn-outline-secondary">
                        پاکسازی
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Logs Table Card -->
    <div class="card card-custom">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-journal-text text-primary"></i>
                <span>فهرست رویدادها (@Model.Logs.Count رویداد ثبت‌شده)</span>
            </h6>
        </div>
        <div class="card-body p-0">
            @if (Model.Logs == null || Model.Logs.Count == 0)
            {
                <div class="text-center py-5 text-muted small">
                    <i class="bi bi-shield-slash fs-2 d-block mb-2"></i>
                    رویدادی با فیلترهای انتخابی یافت نشد.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>زمان دقیق رویداد</th>
                                <th>نوع عملیات</th>
                                <th>آدرس IP</th>
                                <th>پرسش‌نامه</th>
                                <th>توکن / مخاطب</th>
                                <th>جزئیات تکمیلی رویداد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Logs.Count; i++)
                            {
                                var log = Model.Logs[i];
                                <tr>
                                    <td class="text-muted small">@(i + 1)</td>
                                    <td class="text-nowrap small text-muted font-monospace">
                                        @log.Timestamp.ToString("yyyy/MM/dd HH:mm:ss")
                                    </td>
                                    <td>
                                        @if (log.ActionType == "FormSubmitted")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i> ثبت موفق
                                            </span>
                                        }
                                        else if (log.ActionType == "PageOpened")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                <i class="bi bi-box-arrow-in-right me-1"></i> بازگشایی
                                            </span>
                                        }
                                        else if (log.ActionType == "TokenExpired")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-hourglass-bottom me-1"></i> انقضای مهلت
                                            </span>
                                        }
                                        else if (log.ActionType == "TokensGenerated")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                <i class="bi bi-key me-1"></i> صدور لینک‌ها
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">@log.ActionType</span>
                                        }
                                    </td>
                                    <td class="text-nowrap font-monospace small">@log.IPAddress</td>
                                    <td class="small fw-bold">@(string.IsNullOrWhiteSpace(log.QuestionnaireTitle) ? "-" : log.QuestionnaireTitle)</td>
                                    <td class="small">@(string.IsNullOrWhiteSpace(log.RespondentIdentifier) ? (log.TokenId.HasValue ? ("توکن #" + log.TokenId) : "-") : log.RespondentIdentifier)</td>
                                    <td class="small text-muted" style="max-width: 400px;">@log.Details</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
