@model EnterpriseSurveySystem.Models.ViewModels.AnalyticsViewModel
@{
    ViewBag.Title = "تحلیل آماری لحظه‌ای: " + Model.Title;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">داشبورد</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Details", "Admin", new { id = Model.QuestionnaireId })">مدیریت مخاطبان</a></li>
                    <li class="breadcrumb-item active" aria-current="page">تحلیل آماری</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">تحلیل آماری و رفتارسنجی: @Model.Title</h4>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Details", "Admin", new { id = Model.QuestionnaireId })" class="btn btn-outline-primary d-flex align-items-center gap-2">
                <i class="bi bi-people"></i>
                <span>مدیریت مخاطبان و لینک‌ها</span>
            </a>
            <a href="@Url.Action("AuditLogs", "Admin", new { questionnaireId = Model.QuestionnaireId })" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-shield-check"></i>
                <span>لاگ‌های امنیتی</span>
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card card-custom p-3 h-100">
                <span class="text-muted small fw-bold">تعداد کل مخاطبان</span>
                <div class="d-flex align-items-baseline justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalTokens</h3>
                    <span class="badge bg-light text-secondary border">لینک صادره</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card card-custom p-3 h-100">
                <span class="text-muted small fw-bold">پاسخ‌های کامل ثبت‌شده</span>
                <div class="d-flex align-items-baseline justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletedCount</h3>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        نرخ مشارکت: @Model.CompletionRate٪
                    </span>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card card-custom p-3 h-100">
                <span class="text-muted small fw-bold">میانگین زمان پاسخ‌گویی</span>
                <div class="d-flex align-items-baseline justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-primary">@Model.FormattedAverageTime</h3>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">ورود تا ثبت</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card card-custom p-3 h-100">
                <span class="text-muted small fw-bold">منقضی شده بدون پاسخ</span>
                <div class="d-flex align-items-baseline justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-danger">@Model.ExpiredCount</h3>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">اتمام مهلت زمانی</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Response Time Distribution Chart (Strictly Adheres to TimeLimitMinutes!) -->
    <div class="card card-custom mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-stopwatch text-primary fs-5"></i>
                <h6 class="mb-0 fw-bold">توزیع زمان پاسخ‌گویی بر اساس سقف زمانی مصوب (@(Model.TimeLimitMinutes.HasValue ? (Model.TimeLimitMinutes.Value + " دقیقه") : "بدون سقف"))</h6>
            </div>
            @if (Model.TimeLimitMinutes.HasValue && Model.TimeLimitMinutes.Value > 0)
            {
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-1">
                    <i class="bi bi-clock-history me-1"></i> بازه زمانی دقیق: ۱ تا @Model.TimeLimitMinutes دقیقه
                </span>
            }
        </div>
        <div class="card-body p-4">
            @if (Model.TimeDistribution == null || Model.TimeDistribution.Count == 0)
            {
                <div class="text-center py-4 text-muted small">
                    هنوز پاسخی جهت تحلیل زمانی به ثبت نرسیده است.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var item in Model.TimeDistribution)
                    {
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between mb-1 small">
                                <span class="fw-bold text-dark"><i class="bi bi-dot text-primary fs-4 align-middle"></i> @item.Label</span>
                                <span class="text-muted font-monospace">@item.Count نفر (@item.Percentage٪)</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @item.Percentage%" aria-valuenow="@item.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Question by Question Analytical Breakdown -->
    <div class="card card-custom">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
            <i class="bi bi-pie-chart text-primary fs-5"></i>
            <h6 class="mb-0 fw-bold">تحلیل تفکیکی پاسخ‌های سوالات</h6>
        </div>
        <div class="card-body p-4">
            @if (Model.QuestionStats == null || Model.QuestionStats.Count == 0)
            {
                <div class="text-center py-4 text-muted small">
                    سوالی برای این پرسش‌نامه تعریف نشده است.
                </div>
            }
            else
            {
                for (int i = 0; i < Model.QuestionStats.Count; i++)
                {
                    var q = Model.QuestionStats[i];
                    <div class="border rounded-3 p-3 mb-4 bg-light">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-3 pb-2 border-bottom">
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge bg-primary rounded-pill px-2.5 py-1">@(i + 1)</span>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@q.QuestionText</h6>
                                    <small class="text-muted">نوع سوال: @q.QuestionType • تعداد کل پاسخ‌ها: @q.TotalResponses</small>
                                </div>
                            </div>
                        </div>

                        @if (q.QuestionType == "Tashrihi")
                        {
                            <div class="mt-2">
                                <h6 class="small fw-bold text-muted mb-2">دیدگاه‌ها و پاسخ‌های متنی ثبت‌شده:</h6>
                                @if (q.TextResponses.Count == 0)
                                {
                                    <p class="text-muted small py-2">هنوز پاسخی برای این سوال تشریحی ثبت نشده است.</p>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var txt in q.TextResponses)
                                        {
                                            <div class="list-group-item bg-white rounded-2 border mb-2 p-3 small text-dark">
                                                <i class="bi bi-chat-left-quote text-primary me-2"></i> @txt
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mt-2">
                                <h6 class="small fw-bold text-muted mb-2">توزیع آماری گزینه‌ها:</h6>
                                @if (q.Options.Count == 0)
                                {
                                    <p class="text-muted small py-2">داده‌ای برای نمایش گزینه‌ها موجود نیست.</p>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var opt in q.Options)
                                        {
                                            <div class="col-12 col-md-6">
                                                <div class="bg-white border rounded-2 p-2.5">
                                                    <div class="d-flex align-items-center justify-content-between small mb-1">
                                                        <span class="fw-bold">@opt.OptionText</span>
                                                        <span class="text-muted font-monospace">@opt.Count رای (@opt.Percentage٪)</span>
                                                    </div>
                                                    <div class="progress" style="height: 6px;">
                                                        <div class="progress-bar bg-success" role="progressbar" style="width: @opt.Percentage%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
