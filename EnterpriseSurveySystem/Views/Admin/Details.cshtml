@model EnterpriseSurveySystem.Models.ViewModels.QuestionnaireDetailsViewModel
@{
    ViewBag.Title = "مدیریت مخاطبان و لینک‌ها: " + Model.Title;
}

<style>
    .filter-dropdown-menu {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 #f8fafc;
    }
    .filter-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }
    .filter-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
    }
    .filter-dropdown-menu::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }
    .hover-row {
        transition: all 0.15s ease-in-out;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
    }
    .hover-row:hover {
        background-color: #f8fafc !important;
        border-color: #94a3b8 !important;
    }
    .hover-row.is-checked {
        background-color: #eff6ff !important;
        border-color: #3b82f6 !important;
    }
    .dep-level-1 {
        background-color: #f8fafc;
        border-right: 3px solid #0d6efd !important;
    }
    .dep-level-2 {
        border-right: 2px solid #0dcaf0 !important;
    }
    .dep-level-3 {
        border-right: 2px solid #6c757d !important;
    }
</style>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="fw-bold mb-0 text-dark">@Model.Title</h4>
                @if (Model.TimeLimitMinutes.HasValue && Model.TimeLimitMinutes.Value > 0)
                {
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                        <i class="bi bi-stopwatch me-1"></i> مهلت: @Model.TimeLimitMinutes دقیقه
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-secondary border">بدون محدودیت زمانی</span>
                }
                <span class="badge @(Model.ShowRespondentName ? "bg-info-subtle text-info-emphasis border border-info-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                    <i class="bi @(Model.ShowRespondentName ? "bi-person-check" : "bi-shield-lock") me-1"></i>
                    @(Model.ShowRespondentName ? "نمایش نام به مخاطب: فعال" : "نمایش نام به مخاطب: غیرفعال (ناشناس)")
                </span>
                @{
                    string tplPersianName = "مدرن سازمانی شیشه‌ای";
                    switch (Model.TemplateKey)
                    {
                        case "TypeformFocus": tplPersianName = "تعاملی تک‌سوالی Typeform"; break;
                        case "LuxuryDark": tplPersianName = "دارک مود لوکس زمردی"; break;
                        case "MinimalWarm": tplPersianName = "مینیمال فاخر تحلیلی"; break;
                        case "VibrantAurora": tplPersianName = "آئورورا گرادیان پرانرژی"; break;
                    }
                }
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    <i class="bi bi-palette me-1"></i> قالب ظاهری: @tplPersianName
                </span>
            </div>
            <p class="text-muted mb-0 small">@(string.IsNullOrWhiteSpace(Model.Description) ? "بدون توضیحات تکمیلی" : Model.Description)</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("ExportResponsesExcel", "Admin", new { id = Model.Id })" class="btn btn-success d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-file-earmark-excel-fill"></i>
                <span>خروجی اکسل پاسخ‌ها</span>
            </a>
            <a href="@Url.Action("ExportTokens", "Admin", new { id = Model.Id })" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-link-45deg"></i>
                <span>فهرست لینک‌ها (CSV)</span>
            </a>
            <a href="@Url.Action("Analytics", "Admin", new { id = Model.Id })" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-bar-chart-line"></i>
                <span>آمار و تحلیل زمانی</span>
            </a>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- 4 Mini Stats Strip -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3">
                <small class="text-muted fw-bold">کل لینک‌های صادره</small>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <h4 class="fw-bold mb-0 text-dark" id="statTotalTokens">@Model.TotalTokens</h4>
                    <span class="badge bg-light text-secondary border">مخاطب</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3">
                <small class="text-muted fw-bold">تکمیل شده</small>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <h4 class="fw-bold mb-0 text-success">@Model.CompletedCount</h4>
                    <span class="badge bg-success-subtle text-success">@Model.CompletionPercentage٪</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3">
                <small class="text-muted fw-bold">در انتظار پاسخ</small>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <h4 class="fw-bold mb-0 text-warning">@Model.PendingCount</h4>
                    <span class="badge bg-warning-subtle text-warning">مشاهده نشده</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-custom p-3">
                <small class="text-muted fw-bold">منقضی شده</small>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <h4 class="fw-bold mb-0 text-danger">@Model.ExpiredCount</h4>
                    <span class="badge bg-danger-subtle text-danger">عدم ثبت به موقع</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Audience Selection & Personalized Token Generation Panel -->
    <div class="card card-custom mb-4 border-primary-subtle shadow-sm">
        <div class="card-header bg-primary-subtle py-3 border-bottom d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary fs-5"></i>
                <h6 class="mb-0 fw-bold text-primary">صدور لینک‌های اختصاصی بر اساس ساختار سازمانی (دپارتمان، سمت، پرسنل)</h6>
            </div>
            <span class="badge bg-primary text-white px-3 py-1 rounded-pill">
                اتصال مستقیم به دیتابیس پرسنلی
            </span>
        </div>
        <div class="card-body p-4">
            @Html.AntiForgeryToken()
            <p class="text-muted small mb-3">
                با انتخاب همزمان دپارتمان‌ها و سمت‌ها، فهرست پرسنل فعال به‌صورت پویا فیلتر می‌شود. پرسنل مورد نظر را انتخاب نموده و روی دکمه صدور کلیک نمایید:
            </p>

            <div class="row g-3">
                <!-- Dropdown 1: Departments (Tree View) -->
                <div class="col-12 col-lg-4">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between border-bottom">
                            <span class="fw-bold small text-dark"><i class="bi bi-diagram-3-fill me-1 text-primary"></i> ۱. ساختار درختی دپارتمان‌ها</span>
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="checkbox" id="chkAllDepartments" />
                                <label class="form-check-label small fw-semibold" for="chkAllDepartments">انتخاب همه</label>
                            </div>
                        </div>
                        <div class="p-2 bg-light border-bottom">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0" id="searchDepartmentInput" placeholder="جستجوی دپارتمان یا واحد..." />
                            </div>
                        </div>
                        <div class="card-body p-2 filter-dropdown-menu bg-white" id="departmentsList" style="height: 320px; overflow-y: auto;">
                            <div class="text-center py-5 text-muted small">
                                <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                                <div>در حال دریافت ساختار درختی دپارتمان‌ها...</div>
                            </div>
                        </div>
                        <div class="card-footer bg-light py-2 px-3 text-muted small text-end fw-semibold border-top" id="depSelectedCount">
                            ۰ دپارتمان انتخاب شده
                        </div>
                    </div>
                </div>

                <!-- Dropdown 2: Positions (Multi-Select) -->
                <div class="col-12 col-lg-4">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between border-bottom">
                            <span class="fw-bold small text-dark"><i class="bi bi-briefcase-fill me-1 text-primary"></i> ۲. سمت‌ها / پوزیشن‌ها</span>
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="checkbox" id="chkAllPositions" />
                                <label class="form-check-label small fw-semibold" for="chkAllPositions">انتخاب همه</label>
                            </div>
                        </div>
                        <div class="p-2 bg-light border-bottom">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0" id="searchPositionInput" placeholder="جستجوی سمت شغلی..." />
                            </div>
                        </div>
                        <div class="card-body p-2 filter-dropdown-menu bg-white" id="positionsList" style="height: 320px; overflow-y: auto;">
                            <div class="text-center py-5 text-muted small">ابتدا دپارتمان مورد نظر را انتخاب فرمایید.</div>
                        </div>
                        <div class="card-footer bg-light py-2 px-3 text-muted small text-end fw-semibold border-top" id="posSelectedCount">
                            ۰ سمت انتخاب شده
                        </div>
                    </div>
                </div>

                <!-- Dropdown 3: Persons (Multi-Select with Search) -->
                <div class="col-12 col-lg-4">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between border-bottom">
                            <span class="fw-bold small text-dark"><i class="bi bi-person-check-fill me-1 text-primary"></i> ۳. پرسنل فعال سازمانی</span>
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="checkbox" id="chkAllPersons" />
                                <label class="form-check-label small fw-semibold" for="chkAllPersons">انتخاب همه</label>
                            </div>
                        </div>
                        <div class="p-2 bg-light border-bottom">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0" id="searchPersonInput" placeholder="جستجوی نام یا کد پرسنلی..." />
                            </div>
                        </div>
                        <div class="card-body p-2 filter-dropdown-menu bg-white" id="personsList" style="height: 320px; overflow-y: auto;">
                            <div class="text-center py-5 text-muted small">پرسنل منطبق با دپارتمان و سمت نمایش داده می‌شوند.</div>
                        </div>
                        <div class="card-footer bg-light py-2 px-3 d-flex align-items-center justify-content-between small border-top">
                            <span class="text-muted fw-semibold" id="totalPersonsFound">۰ نفر یافت شد</span>
                            <span class="badge bg-primary text-white px-2 py-1" id="personSelectedCount">۰ نفر انتخاب شده</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Generate Action Bar -->
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mt-4 pt-3 border-top">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border p-2">
                        <i class="bi bi-info-circle text-primary me-1"></i> لینک‌های صادره منحصر‌به‌فرد بوده و مشخصات پرسنل در جدول ذخیره خواهد شد.
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-primary px-4 d-flex align-items-center gap-2 shadow-sm" id="btnGeneratePersonTokens">
                        <i class="bi bi-send-check fs-5"></i>
                        <span id="btnGenerateText">تولید لینک‌های اختصاصی برای پرسنل انتخابی</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tokens List Table -->
    <div class="card card-custom">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-link-45deg text-primary fs-5"></i>
                <h6 class="mb-0 fw-bold">فهرست لینک‌های اختصاصی صادر شده (@Model.Tokens.Count لینک)</h6>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="text" class="form-control form-control-sm" id="tokenFilterInput" placeholder="فیلتر نام یا کد پرسنلی..." style="width: 200px;" />
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Tokens == null || Model.Tokens.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-link-45deg fs-2 d-block mb-2"></i>
                    <div>هنوز هیچ لینکی برای این پرسش‌نامه صادر نشده است.</div>
                    <small>از پنل بالا پرسنل مورد نظر را انتخاب و لینک‌های اختصاصی را صادر فرمایید.</small>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0" id="tokensTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>نام و نام خانوادگی مخاطب</th>
                                <th class="text-center">کد پرسنلی</th>
                                <th>دپارتمان و سمت</th>
                                <th class="text-center">وضعیت</th>
                                <th>لینک اختصاصی یکبارمصرف</th>
                                <th class="text-center">زمان بازگشایی</th>
                                <th class="text-center">زمان ثبت نهایی</th>
                                <th class="text-start">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Tokens.Count; i++)
                            {
                                var t = Model.Tokens[i];
                                <tr>
                                    <td class="text-muted small">@(i + 1)</td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @(string.IsNullOrWhiteSpace(t.PersonFullName) ? t.RespondentIdentifier : t.PersonFullName)
                                        </div>
                                    </td>
                                    <td class="text-center font-monospace small">
                                        @(t.PersonelCode.HasValue ? t.PersonelCode.Value.ToString() : "-")
                                    </td>
                                    <td>
                                        <div class="small text-dark">@(string.IsNullOrWhiteSpace(t.DepartmentName) ? "-" : t.DepartmentName)</div>
                                        <small class="text-muted">@(string.IsNullOrWhiteSpace(t.PositionName) ? "" : t.PositionName)</small>
                                    </td>
                                    <td class="text-center">
                                        @if (t.StatusKey == "Completed")
                                        {
                                            <span class="badge badge-status badge-completed"><i class="bi bi-check-circle"></i> @t.StatusPersianTitle</span>
                                        }
                                        else if (t.StatusKey == "Expired")
                                        {
                                            <span class="badge badge-status badge-expired"><i class="bi bi-x-circle"></i> @t.StatusPersianTitle</span>
                                        }
                                        else if (t.StatusKey == "Viewed")
                                        {
                                            <span class="badge badge-status badge-viewed"><i class="bi bi-eye"></i> @t.StatusPersianTitle</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-status badge-pending"><i class="bi bi-hourglass"></i> @t.StatusPersianTitle</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm" style="max-width: 320px;">
                                            <input type="text" class="form-control font-monospace text-start" value="@t.SurveyUrl" readonly id="url_@t.Id" style="direction: ltr; font-size: 0.75rem;" />
                                            <button class="btn btn-outline-secondary btn-copy" type="button" data-target="url_@t.Id" title="کپی لینک">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="text-center small text-nowrap">
                                        @(t.OpenedAt.HasValue ? t.OpenedAt.Value.ToString("MM/dd HH:mm") : "-")
                                    </td>
                                    <td class="text-center small text-nowrap">
                                        @(t.CompletedAt.HasValue ? t.CompletedAt.Value.ToString("MM/dd HH:mm") : "-")
                                    </td>
                                    <td class="text-start">
                                        <div class="d-flex align-items-center gap-1">
                                            @if (t.StatusKey == "Completed" || t.CompletedAt.HasValue)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success btn-view-response d-flex align-items-center gap-1 px-2" data-token-id="@t.Id" data-name="@(string.IsNullOrWhiteSpace(t.PersonFullName) ? t.RespondentIdentifier : t.PersonFullName)" title="مشاهده پاسخ‌های ثبت‌شده">
                                                    <i class="bi bi-eye-fill"></i>
                                                    <span class="small">پاسخ‌ها</span>
                                                </button>
                                            }
                                            else if (t.StatusKey == "Expired")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning text-dark btn-reactivate-token d-flex align-items-center gap-1 px-2 shadow-sm" data-token-id="@t.Id" data-name="@(string.IsNullOrWhiteSpace(t.PersonFullName) ? t.RespondentIdentifier : t.PersonFullName)" title="فعال‌سازی مجدد مهلت پاسخ‌دهی">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                    <span class="small">فعال‌سازی مجدد</span>
                                                </button>
                                            }
                                            <a href="@t.SurveyUrl" target="_blank" class="btn btn-sm btn-outline-primary" title="بازگشایی و مشاهده فرم">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Readonly Modal for viewing respondent answers -->
<div class="modal fade" id="modalRespondentAnswers" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill fs-5"></i>
                    <h5 class="modal-title fw-bold" id="modalRespondentTitle">مشاهده پاسخ‌های ثبت‌شده</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body p-4 bg-light" id="modalRespondentContent">
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-2"></div>
                    <div>در حال دریافت پاسخ‌های ثبت‌شده...</div>
                </div>
            </div>
            <div class="modal-footer bg-white border-top py-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var questionnaireId = @Model.Id;
    var existingPersonIds = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Tokens.Where(t => t.PersonId.HasValue).Select(t => t.PersonId.Value).Distinct().ToList()));
    var existingPersonIdsSet = new Set(existingPersonIds);
    var allDepartments = [];
    var allPositions = [];
    var allPersons = [];
    var selectedPersonIdsSet = new Set();

    // Load Departments on page load (Tree Structure)
    function loadDepartments() {
        $.getJSON('@Url.Action("GetDepartments", "Admin")', function(res) {
            if (res.success && res.data) {
                allDepartments = res.data;
                renderDepartments(allDepartments);
            } else {
                $('#departmentsList').html('<div class="text-danger p-2 small">خطا در دریافت دپارتمان‌ها: ' + (res.message || '') + '</div>');
            }
        }).fail(function() {
            $('#departmentsList').html('<div class="text-danger p-2 small">عدم برقراری ارتباط با دیتابیس پرسنلی</div>');
        });
    }

    function renderDepartments(deps) {
        var filterText = $('#searchDepartmentInput').val() ? $('#searchDepartmentInput').val().trim().toLowerCase() : '';
        var html = '';

        if (!deps || deps.length === 0) {
            $('#departmentsList').html('<div class="text-muted p-4 small text-center">هیچ دپارتمان فعالی یافت نشد.</div>');
            return;
        }

        deps.forEach(function(d) {
            if (filterText && !d.DepNameFa.toLowerCase().includes(filterText)) {
                return;
            }

            var indentPx = Math.max(0, (d.DepLevel - 1)) * 18;
            var iconHtml = '';
            var levelClass = 'dep-level-' + d.DepLevel;

            if (d.DepLevel === 1) {
                iconHtml = '<i class="bi bi-building-fill text-primary me-2"></i>';
            } else if (d.DepLevel === 2) {
                iconHtml = '<span class="text-muted small me-1">└─</span><i class="bi bi-diagram-3-fill text-info me-1"></i>';
            } else {
                iconHtml = '<span class="text-muted small me-1">└──</span><i class="bi bi-circle-fill text-secondary me-1" style="font-size:0.35rem;"></i>';
            }

            html += `
            <div class="hover-row ${levelClass} p-2 mb-1 rounded shadow-none" 
                 style="margin-right: ${indentPx}px;" 
                 data-dep-id="${d.DepartmentId}" 
                 data-parent-id="${d.DepHdrId}" 
                 data-level="${d.DepLevel}">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center flex-grow-1">
                        <input class="form-check-input chk-dep m-0 me-2 cursor-pointer flex-shrink-0" 
                               type="checkbox" 
                               value="${d.DepartmentId}" 
                               id="dep_${d.DepartmentId}"
                               data-dep-id="${d.DepartmentId}"
                               data-parent-id="${d.DepHdrId}"
                               data-level="${d.DepLevel}">
                        <label class="form-check-label cursor-pointer m-0 d-flex align-items-center user-select-none" for="dep_${d.DepartmentId}">
                            ${iconHtml}
                            <span class="${d.DepLevel === 1 ? 'fw-bold text-dark' : (d.DepLevel === 2 ? 'fw-semibold text-dark' : 'text-secondary')}">${d.DepNameFa}</span>
                        </label>
                    </div>
                    <span class="badge ${d.DepLevel === 1 ? 'bg-primary-subtle text-primary' : 'bg-light text-muted'} border small ms-2 flex-shrink-0" style="font-size:0.65rem;">سطح ${d.DepLevel}</span>
                </div>
            </div>`;
        });

        $('#departmentsList').html(html || '<div class="text-muted p-4 small text-center">دپارتمانی با این نام یافت نشد.</div>');
    }

    function setChildDepartmentsChecked(parentId, isChecked) {
        $('.chk-dep[data-parent-id="' + parentId + '"]').each(function() {
            $(this).prop('checked', isChecked);
            if (isChecked) {
                $(this).closest('.hover-row').addClass('is-checked');
            } else {
                $(this).closest('.hover-row').removeClass('is-checked');
            }
            var childId = $(this).val();
            setChildDepartmentsChecked(childId, isChecked);
        });
    }

    function getSelectedDepartmentIds() {
        var ids = [];
        $('.chk-dep:checked').each(function() {
            ids.push(parseInt($(this).val()));
        });
        return ids;
    }

    function getSelectedPositionIds() {
        var ids = [];
        $('.chk-pos:checked').each(function() {
            ids.push(parseInt($(this).val()));
        });
        return ids;
    }

    function getSelectedPersonIds() {
        var ids = [];
        $('.chk-person:checked:not(:disabled)').each(function() {
            ids.push(parseInt($(this).val()));
        });
        return ids;
    }

    function loadPositions() {
        var depIds = getSelectedDepartmentIds();
        $('#positionsList').html('<div class="text-center py-5 text-muted small"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>در حال بارگذاری سمت‌ها...</div></div>');

        $.ajax({
            url: '@Url.Action("GetPositions", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ departmentIds: depIds }),
            success: function(res) {
                if (res.success && res.data) {
                    allPositions = res.data;
                    renderPositions(allPositions);
                    $('#chkAllPositions').prop('checked', false);
                    updatePositionCount();
                    loadPersons();
                }
            }
        });
    }

    function renderPositions(positions) {
        var filterText = $('#searchPositionInput').val() ? $('#searchPositionInput').val().trim().toLowerCase() : '';
        var html = '';

        var filtered = positions.filter(function(p) {
            if (!filterText) return true;
            return (p.PositionNameFa && p.PositionNameFa.toLowerCase().includes(filterText)) ||
                   (p.DepartmentName && p.DepartmentName.toLowerCase().includes(filterText));
        });

        if (filtered.length === 0) {
            $('#positionsList').html('<div class="text-muted p-4 small text-center">سمتی یافت نشد.</div>');
            return;
        }

        filtered.forEach(function(p) {
            html += `
            <div class="hover-row p-2 mb-1 rounded">
                <div class="d-flex align-items-start">
                    <input class="form-check-input chk-pos m-0 me-2 mt-1 cursor-pointer flex-shrink-0" 
                           type="checkbox" 
                           value="${p.PositionId}" 
                           id="pos_${p.PositionId}">
                    <div class="flex-grow-1">
                        <label class="form-check-label cursor-pointer d-block fw-bold text-dark m-0" for="pos_${p.PositionId}">
                            ${p.PositionNameFa}
                        </label>
                        <div class="text-muted small mt-1 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                            <i class="bi bi-diagram-3 text-primary"></i>
                            <span>${p.DepartmentName || 'دپارتمان نامشخص'}</span>
                        </div>
                    </div>
                </div>
            </div>`;
        });

        $('#positionsList').html(html);
    }

    function loadPersons() {
        var depIds = getSelectedDepartmentIds();
        var posIds = getSelectedPositionIds();

        $('#personsList').html('<div class="text-center py-5 text-muted small"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>در حال بارگذاری پرسنل...</div></div>');

        $.ajax({
            url: '@Url.Action("GetPersons", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ departmentIds: depIds, positionIds: posIds }),
            success: function(res) {
                if (res.success && res.data) {
                    allPersons = res.data;
                    renderPersons(allPersons);
                    $('#totalPersonsFound').text(allPersons.length + ' نفر یافت شد');
                    $('#chkAllPersons').prop('checked', false);
                    updatePersonCount();
                }
            }
        });
    }

    function renderPersons(persons) {
        var filterText = $('#searchPersonInput').val() ? $('#searchPersonInput').val().trim().toLowerCase() : '';
        var html = '';

        var filtered = persons.filter(function(p) {
            if (!filterText) return true;
            return (p.FullName && p.FullName.toLowerCase().includes(filterText)) ||
                   (p.PersonelCode && p.PersonelCode.toString().includes(filterText)) ||
                   (p.PositionName && p.PositionName.toLowerCase().includes(filterText)) ||
                   (p.DepartmentName && p.DepartmentName.toLowerCase().includes(filterText));
        });

        if (filtered.length === 0) {
            $('#personsList').html('<div class="text-muted p-4 small text-center">هیچ پرسنلی یافت نشد.</div>');
            return;
        }

        filtered.forEach(function(p) {
            var alreadyIssued = existingPersonIdsSet.has(p.PersonId);
            var isChecked = !alreadyIssued && selectedPersonIdsSet.has(p.PersonId);
            var rowClass = '';
            if (alreadyIssued) {
                rowClass = 'bg-light text-muted opacity-75';
            } else if (isChecked) {
                rowClass = 'is-checked';
            }

            html += `
            <div class="hover-row p-2 mb-1 rounded ${rowClass}" ${alreadyIssued ? 'title="قبلاً برای این مخاطب لینک صادر شده است و لینک مجدد صادر نمی‌شود."' : ''}>
                <div class="d-flex align-items-start">
                    <input class="form-check-input chk-person m-0 me-2 mt-1 ${alreadyIssued ? '' : 'cursor-pointer'} flex-shrink-0" 
                           type="checkbox" 
                           value="${p.PersonId}" 
                           id="person_${p.PersonId}"
                           ${alreadyIssued ? 'disabled checked' : (isChecked ? 'checked' : '')}>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="form-check-label ${alreadyIssued ? 'text-muted' : 'cursor-pointer fw-bold text-dark'} m-0" for="person_${p.PersonId}">
                                ${p.FullName}
                            </label>
                            <div class="d-flex align-items-center gap-1">
                                ${alreadyIssued ? '<span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.65rem;"><i class="bi bi-link-45deg me-1"></i>لینک صادر شده</span>' : ''}
                                <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.68rem;">کد: ${p.PersonelCode}</span>
                            </div>
                        </div>
                        <div class="text-muted small mt-1 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                            <i class="bi bi-briefcase text-secondary"></i>
                            <span>${p.PositionName || p.DepartmentName}</span>
                        </div>
                    </div>
                </div>
            </div>`;
        });

        $('#personsList').html(html);
    }

    function updateDepartmentCount() {
        var count = getSelectedDepartmentIds().length;
        $('#depSelectedCount').text(count + ' دپارتمان انتخاب شده');
    }

    function updatePositionCount() {
        var count = getSelectedPositionIds().length;
        $('#posSelectedCount').text(count + ' سمت انتخاب شده');
    }

    function updatePersonCount() {
        var count = getSelectedPersonIds().length;
        $('#personSelectedCount').text(count + ' نفر انتخاب شده');
        if (count > 0) {
            $('#btnGenerateText').text(`تولید لینک‌های اختصاصی برای ${count} نفر انتخابی`);
            $('#btnGeneratePersonTokens').prop('disabled', false);
        } else {
            $('#btnGenerateText').text('تولید لینک‌های اختصاصی برای پرسنل انتخابی');
            $('#btnGeneratePersonTokens').prop('disabled', true);
        }
    }

    $(document).ready(function() {
        loadDepartments();
        loadPositions();
        updatePersonCount();

        // Department search filter
        $('#searchDepartmentInput').on('input', function() {
            renderDepartments(allDepartments);
        });

        // Position search filter
        $('#searchPositionInput').on('input', function() {
            renderPositions(allPositions);
        });

        // Row checkbox toggle highlight
        $(document).on('change', '.chk-dep, .chk-pos, .chk-person', function() {
            if ($(this).is(':checked')) {
                $(this).closest('.hover-row').addClass('is-checked');
            } else {
                $(this).closest('.hover-row').removeClass('is-checked');
            }
        });

        // Department checkbox change (Cascades down tree)
        $(document).on('change', '.chk-dep', function() {
            var isChecked = $(this).is(':checked');
            var depId = $(this).val();
            setChildDepartmentsChecked(depId, isChecked);

            updateDepartmentCount();
            loadPositions();
        });

        // "Select all departments"
        $('#chkAllDepartments').on('change', function() {
            var checked = $(this).is(':checked');
            $('.chk-dep').prop('checked', checked);
            updateDepartmentCount();
            loadPositions();
        });

        // Position checkbox change
        $(document).on('change', '.chk-pos', function() {
            updatePositionCount();
            loadPersons();
        });

        // "Select all positions"
        $('#chkAllPositions').on('change', function() {
            var checked = $(this).is(':checked');
            $('.chk-pos').prop('checked', checked);
            updatePositionCount();
            loadPersons();
        });

        // Person checkbox change (exclude disabled)
        $(document).on('change', '.chk-person:not(:disabled)', function() {
            var pid = parseInt($(this).val());
            if ($(this).is(':checked')) {
                selectedPersonIdsSet.add(pid);
                $(this).closest('.hover-row').addClass('is-checked');
            } else {
                selectedPersonIdsSet.delete(pid);
                $(this).closest('.hover-row').removeClass('is-checked');
            }
            updatePersonCount();
        });

        // "Select all persons" (only toggle non-disabled)
        $('#chkAllPersons').on('change', function() {
            var checked = $(this).is(':checked');
            $('.chk-person:not(:disabled)').each(function() {
                $(this).prop('checked', checked);
                var pid = parseInt($(this).val());
                if (checked) {
                    selectedPersonIdsSet.add(pid);
                    $(this).closest('.hover-row').addClass('is-checked');
                } else {
                    selectedPersonIdsSet.delete(pid);
                    $(this).closest('.hover-row').removeClass('is-checked');
                }
            });
            updatePersonCount();
        });

        // Person search filter
        $('#searchPersonInput').on('input', function() {
            renderPersons(allPersons);
            updatePersonCount();
        });

        // Table search filter
        $('#tokenFilterInput').on('input', function() {
            var query = $(this).val().toLowerCase();
            $('#tokensTable tbody tr').each(function() {
                var rowText = $(this).text().toLowerCase();
                $(this).toggle(rowText.indexOf(query) > -1);
            });
        });

        // Generate tokens click
        $('#btnGeneratePersonTokens').on('click', function() {
            var personIds = getSelectedPersonIds();
            if (personIds.length === 0) {
                alert('لطفاً حداقل یک نفر از لیست پرسنل را انتخاب فرمایید.');
                return;
            }

            var btn = $(this);
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال صدور لینک‌های اختصاصی...');

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("GenerateTokensForPersons", "Admin")',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': token
                },
                data: JSON.stringify({
                    QuestionnaireId: questionnaireId,
                    PersonIds: personIds
                }),
                success: function(res) {
                    if (res.success) {
                        alert(res.message);
                        window.location.reload();
                    } else {
                        alert('خطا: ' + res.message);
                        btn.prop('disabled', false).html('<i class="bi bi-send-check fs-5"></i> <span>تولید لینک‌های اختصاصی</span>');
                    }
                },
                error: function(err) {
                    alert('خطا در برقراری ارتباط با سرور.');
                    btn.prop('disabled', false).html('<i class="bi bi-send-check fs-5"></i> <span>تولید لینک‌های اختصاصی</span>');
                }
            });
        });

        // View respondent answers click
        $(document).on('click', '.btn-view-response', function() {
            var tokenId = $(this).data('token-id');
            var respondentName = $(this).data('name') || 'مخاطب';
            
            $('#modalRespondentTitle').text('مشاهده پاسخ‌های ثبت‌شده: ' + respondentName);
            $('#modalRespondentContent').html('<div class="text-center py-5 text-muted"><div class="spinner-border text-primary mb-2"></div><div>در حال دریافت پاسخ‌های ثبت‌شده...</div></div>');
            
            var modal = new bootstrap.Modal(document.getElementById('modalRespondentAnswers'));
            modal.show();

            $.getJSON('@Url.Action("GetRespondentAnswers", "Admin")', { tokenId: tokenId }, function(res) {
                if (!res.success || !res.data) {
                    $('#modalRespondentContent').html('<div class="alert alert-danger p-3 mb-0">' + (res.message || 'خطا در بارگذاری پاسخ‌ها.') + '</div>');
                    return;
                }

                var d = res.data;
                var html = '';

                // Header info strip
                html += `
                <div class="card card-custom p-3 mb-3 bg-white border">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <small class="text-muted d-block">نام و نام خانوادگی</small>
                            <strong class="text-dark">${d.RespondentName}</strong>
                        </div>
                        <div class="col-6 col-md-3">
                            <small class="text-muted d-block">کد پرسنلی</small>
                            <span class="badge bg-light text-secondary border font-monospace">${d.PersonelCode || '-'}</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <small class="text-muted d-block">دپارتمان و سمت</small>
                            <span class="small text-dark d-block text-truncate" title="${d.DepartmentName}">${d.DepartmentName}</span>
                            <small class="text-muted text-truncate d-block" title="${d.PositionName}">${d.PositionName}</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <small class="text-muted d-block">مدت زمان پاسخ‌گویی</small>
                            <span class="badge bg-info-subtle text-info border font-monospace">${d.DurationFormatted}</span>
                        </div>
                    </div>
                </div>`;

                // Questions & Answers list
                html += '<h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2"><i class="bi bi-card-checklist text-primary"></i> پاسخ‌های ثبت‌شده به تفکیک سوالات</h6>';

                if (!d.Answers || d.Answers.length === 0) {
                    html += '<div class="alert alert-warning p-3 small mb-0">هیچ پاسخی برای این مخاطب ثبت نشده است.</div>';
                } else {
                    d.Answers.forEach(function(ans) {
                        var ansHtml = '';

                        if (ans.QuestionType === 'MultiSelect' && ans.MultiSelectAnswers && ans.MultiSelectAnswers.length > 0) {
                            ansHtml = '<div class="d-flex flex-wrap gap-2 mt-2">';
                            ans.MultiSelectAnswers.forEach(function(item) {
                                ansHtml += `<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6"><i class="bi bi-check2 me-1"></i>${item}</span>`;
                            });
                            ansHtml += '</div>';
                        } else if (ans.QuestionType === 'Tashrihi') {
                            ansHtml = `<div class="p-3 bg-light rounded border text-dark mt-2" style="white-space: pre-wrap; font-size: 0.9rem; line-height: 1.8;">${ans.FormattedAnswer || 'پاسخی ثبت نشده است.'}</div>`;
                        } else {
                            ansHtml = `
                            <div class="mt-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6 d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>${ans.FormattedAnswer}</span>
                                </span>
                            </div>`;
                        }

                        var imgHtml = '';
                        if (ans.ImageUrl) {
                            imgHtml = `
                            <div class="mb-2 text-start">
                                <a href="${ans.ImageUrl}" target="_blank" title="مشاهده تصویر پیوست سوال">
                                    <img src="${ans.ImageUrl}" class="img-thumbnail rounded bg-white shadow-sm" style="max-height: 140px; max-width: 100%; object-fit: contain;" />
                                </a>
                            </div>`;
                        }

                        html += `
                        <div class="card card-custom p-3 mb-3 bg-white border">
                            <div class="d-flex align-items-start justify-content-between gap-2 border-bottom pb-2 mb-2">
                                <span class="fw-bold text-dark small">
                                    <span class="badge bg-primary text-white me-1">سوال ${ans.QuestionNumber}</span>
                                    ${ans.QuestionText}
                                </span>
                                <span class="badge bg-light text-muted border flex-shrink-0 small">${ans.QuestionTypePersian}</span>
                            </div>
                            ${imgHtml}
                            <div>
                                <small class="text-muted d-block mb-1">پاسخ ثبت‌شده:</small>
                                ${ansHtml}
                            </div>
                        </div>`;
                    });
                }

                $('#modalRespondentContent').html(html);
            }).fail(function() {
                $('#modalRespondentContent').html('<div class="alert alert-danger p-3 mb-0">عدم برقراری ارتباط با سرور.</div>');
            });
        });

        // Copy button
        $('.btn-copy').on('click', function() {
            var targetId = $(this).data('target');
            var input = document.getElementById(targetId);
            input.select();
            input.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(input.value);

            var icon = $(this).find('i');
            icon.removeClass('bi-clipboard').addClass('bi-check-lg text-success');
            setTimeout(function() {
                icon.removeClass('bi-check-lg text-success').addClass('bi-clipboard');
            }, 1500);
        });

        // Reactivate Expired Token handler
        $(document).on('click', '.btn-reactivate-token', function() {
            var btn = $(this);
            var tokenId = btn.data('token-id');
            var name = btn.data('name');

            if (!confirm('آیا از فعال‌سازی مجدد مهلت پاسخ‌دهی برای «' + name + '» اطمینان دارید؟\nبا این اقدام، وضعیت لینک به «در انتظار» تغییر یافته و کاربر با بازگشایی لینک، مجدداً مهلت کامل برای شرکت در آزمون را خواهد داشت.')) {
                return;
            }

            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> در حال انجام...');

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("ReactivateToken", "Admin")',
                type: 'POST',
                data: {
                    tokenId: tokenId,
                    __RequestVerificationToken: token
                },
                success: function(res) {
                    if (res.success) {
                        alert(res.message);
                        window.location.reload();
                    } else {
                        alert('خطا: ' + (res.message || 'امکان فعال‌سازی مجدد وجود ندارد.'));
                        btn.prop('disabled', false).html('<i class="bi bi-arrow-clockwise"></i> فعال‌سازی مجدد');
                    }
                },
                error: function() {
                    alert('خطا در برقراری ارتباط با سرور.');
                    btn.prop('disabled', false).html('<i class="bi bi-arrow-clockwise"></i> فعال‌سازی مجدد');
                }
            });
        });
    });
</script>
}
