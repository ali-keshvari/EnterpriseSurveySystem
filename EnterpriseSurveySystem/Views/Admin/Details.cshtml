@model EnterpriseSurveySystem.Models.ViewModels.QuestionnaireDetailsViewModel
@{
    ViewBag.Title = "مدیریت مخاطبان و لینک‌های اختصاصی";
}

<div class="space-y-8">
    <!-- Header with Breadcrumbs & Action Buttons -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-surface-container-high">
        <div>
            <div class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant mb-1">
                <a href="@Url.Action("Index", "Admin")" class="hover:text-primary transition">داشبورد</a>
                <span>/</span>
                <span>پرسش‌نامه شماره #@Model.Id</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg font-bold text-on-surface">@Model.Title</h1>
        </div>

        <div class="flex items-center gap-3">
            <a href="@Url.Action("Analytics", "Admin", new { id = Model.Id })" class="inline-flex items-center gap-1.5 bg-primary-container text-on-primary hover:bg-primary font-label-md text-label-md font-semibold px-4 py-2 rounded-xl transition">
                <span class="material-symbols-outlined text-sm">insights</span>
                <span>مشاهده گزارش و تحلیل</span>
            </a>
            <a href="@Url.Action("ExportTokens", "Admin", new { id = Model.Id })" class="inline-flex items-center gap-1.5 bg-surface-container-lowest border border-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold px-4 py-2 rounded-xl shadow-sm transition">
                <span class="material-symbols-outlined text-sm text-tertiary">download</span>
                <span>خروجی اکسل (CSV)</span>
            </a>
        </div>
    </div>

    <!-- Stats & Status Bar matching Stitch _2 -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3.5">
        <!-- Total -->
        <div class="bg-surface-container-lowest border border-surface-container rounded-xl p-4 shadow-sm text-center">
            <p class="font-label-sm text-label-sm text-on-surface-variant mb-1">کل لینک‌های صادره</p>
            <p class="font-headline-lg text-headline-lg font-extrabold text-on-surface tabular-nums">@Model.TotalTokens</p>
        </div>

        <!-- Pending (در انتظار) -->
        <div class="bg-surface-container-lowest border border-surface-container rounded-xl p-4 shadow-sm text-center">
            <p class="font-label-sm text-label-sm text-outline mb-1 flex items-center justify-center gap-1">
                <span class="w-2 h-2 rounded-full bg-outline animate-pulse"></span>
                <span>در انتظار ورود</span>
            </p>
            <p class="font-headline-lg text-headline-lg font-extrabold text-outline tabular-nums">@Model.PendingCount</p>
        </div>

        <!-- Viewed (مشاهده شده) -->
        <div class="bg-surface-container-lowest border border-surface-container rounded-xl p-4 shadow-sm text-center">
            <p class="font-label-sm text-label-sm text-secondary mb-1 flex items-center justify-center gap-1">
                <span class="w-2 h-2 rounded-full bg-secondary"></span>
                <span>مشاهده شده (تایمر فعال)</span>
            </p>
            <p class="font-headline-lg text-headline-lg font-extrabold text-secondary tabular-nums">@Model.ViewedCount</p>
        </div>

        <!-- Completed (تکمیل شده) -->
        <div class="bg-surface-container-lowest border border-surface-container rounded-xl p-4 shadow-sm text-center">
            <p class="font-label-sm text-label-sm text-tertiary mb-1 flex items-center justify-center gap-1">
                <span class="w-2 h-2 rounded-full bg-tertiary"></span>
                <span>تکمیل شده</span>
            </p>
            <p class="font-headline-lg text-headline-lg font-extrabold text-tertiary tabular-nums">@Model.CompletedCount</p>
        </div>

        <!-- Expired (منقضی شده) -->
        <div class="bg-surface-container-lowest border border-surface-container rounded-xl p-4 shadow-sm text-center">
            <p class="font-label-sm text-label-sm text-error mb-1 flex items-center justify-center gap-1">
                <span class="w-2 h-2 rounded-full bg-error"></span>
                <span>منقضی شده</span>
            </p>
            <p class="font-headline-lg text-headline-lg font-extrabold text-error tabular-nums">@Model.ExpiredCount</p>
        </div>
    </div>

    <!-- Quick Token Generator Box -->
    <div class="bg-surface-container-lowest border border-surface-container rounded-2xl p-5 shadow-sm">
        <form method="post" action="@Url.Action("GenerateTokens", "Admin")" class="flex flex-col sm:flex-row items-center justify-between gap-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary-container/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-xl">vpn_key</span>
                </div>
                <div>
                    <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">تولید توکن‌های اختصاصی جدید</h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant">تولید لینک‌های رمزنگاری‌شده یکبارمصرف برای مخاطبان اضافه</p>
                </div>
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <input type="number" name="count" value="10" min="1" max="500" class="w-24 font-body-md text-body-md p-2 rounded-xl border border-surface-container-high bg-surface-container-lowest text-center font-bold text-on-surface" />
                <button type="submit" class="inline-flex items-center gap-1.5 bg-primary-container text-on-primary hover:bg-primary font-label-md text-label-md font-semibold px-4 py-2 rounded-xl shadow-sm transition">
                    <span class="material-symbols-outlined text-sm">add</span>
                    <span>تولید توکن‌ها</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Tokens Table matching Stitch _2 -->
    <div class="bg-surface-container-lowest border border-surface-container rounded-2xl shadow-sm overflow-hidden">
        <div class="p-5 sm:px-6 border-b border-surface-container-high flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">group</span>
                <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">فهرست لینک‌های اختصاصی مخاطبان</h2>
            </div>
            <span class="font-label-sm text-label-sm text-on-surface-variant">مجموع: @Model.Tokens.Count لینک</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right font-body-sm text-body-sm border-collapse">
                <thead class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md border-b border-surface-container-high">
                    <tr>
                        <th class="py-3.5 px-6 font-semibold">شناسه مخاطب</th>
                        <th class="py-3.5 px-4 font-semibold">وضعیت</th>
                        <th class="py-3.5 px-4 font-semibold">اولین ورود (بازگشایی)</th>
                        <th class="py-3.5 px-4 font-semibold">پایان مهلت زمانی</th>
                        <th class="py-3.5 px-4 font-semibold">ثبت نهایی</th>
                        <th class="py-3.5 px-6 font-semibold text-center">لینک مستقیم آزمون</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container text-on-surface">
                    @if (Model.Tokens.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="py-10 text-center text-on-surface-variant">
                                هنوز هیچ لینکی برای این پرسش‌نامه تولید نشده است. با استفاده از کادر بالا، توکن‌های جدید صادر فرمایید.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var token in Model.Tokens)
                        {
                            <tr class="hover:bg-surface-container-low/40 transition">
                                <td class="py-3.5 px-6 font-semibold text-on-surface">
                                    <div>
                                        <span class="font-bold">@token.RespondentIdentifier</span>
                                        <span class="block font-mono text-on-surface-variant text-xs font-normal">@token.TokenGuid</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @switch (token.StatusKey)
                                    {
                                        case "Completed":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-tertiary-container/15 text-tertiary border border-tertiary-container/30">
                                                <span class="material-symbols-outlined text-xs">check</span>
                                                <span>تکمیل شده</span>
                                            </span>
                                            break;
                                        case "Expired":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-error-container/20 text-error border border-error-container">
                                                <span class="material-symbols-outlined text-xs">close</span>
                                                <span>منقضی شده</span>
                                            </span>
                                            break;
                                        case "Viewed":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-surface-container-high text-secondary border border-surface-container">
                                                <span class="material-symbols-outlined text-xs">visibility</span>
                                                <span>مشاهده شده (تایمر فعال)</span>
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-surface-container text-outline border border-surface-container-high">
                                                <span class="w-1.5 h-1.5 rounded-full bg-outline animate-pulse"></span>
                                                <span>در انتظار ورود</span>
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-on-surface font-mono text-xs tabular-nums">
                                    @(token.OpenedAt.HasValue ? token.OpenedAt.Value.ToString("yyyy/MM/dd HH:mm:ss") : "-")
                                </td>
                                <td class="py-3.5 px-4 text-on-surface font-mono text-xs tabular-nums">
                                    @(token.ExpiresAt.HasValue ? token.ExpiresAt.Value.ToString("yyyy/MM/dd HH:mm:ss") : "-")
                                </td>
                                <td class="py-3.5 px-4 text-on-surface font-mono text-xs tabular-nums">
                                    @(token.CompletedAt.HasValue ? token.CompletedAt.Value.ToString("yyyy/MM/dd HH:mm:ss") : "-")
                                </td>
                                <td class="py-3.5 px-6 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <button type="button" onclick="copyToClipboard('@token.SurveyUrl', this)" class="inline-flex items-center gap-1 bg-surface-container-high hover:bg-surface-container-highest text-on-surface px-3 py-1.5 rounded-lg font-label-sm text-label-sm font-semibold transition" title="کپی آدرس اختصاصی">
                                            <span class="material-symbols-outlined text-xs">content_copy</span>
                                            <span>کپی لینک</span>
                                        </button>
                                        <a href="@token.SurveyUrl" target="_blank" class="inline-flex items-center gap-1 bg-primary-container text-on-primary hover:bg-primary px-3 py-1.5 rounded-lg font-label-sm text-label-sm font-semibold transition" title="تست ورود">
                                            <span class="material-symbols-outlined text-xs">open_in_new</span>
                                            <span>تست ورود</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
