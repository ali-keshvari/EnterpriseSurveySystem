@model EnterpriseSurveySystem.Models.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "داشبورد و آمار کل";
}

<div class="container-fluid px-0">
    <!-- Header Title Bar -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="mb-0 fw-bold text-dark">داشبورد و آمار کل پرسش‌نامه‌های سازمانی</h4>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                    <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> سامانه برخط
                </span>
            </div>
            <p class="text-muted mb-0 small">پایش لحظه‌ای مشارکت پرسنل، مدیریت لینک‌های یکبارمصرف و نظارت بر رویدادهای سیستم</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Create", "Admin")" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-circle"></i>
                <span>تعریف پرسش‌نامه جدید</span>
            </a>
            <a href="@Url.Action("AuditLogs", "Admin")" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-clock-history"></i>
                <span>لاگ‌های سیستم</span>
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-custom h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-medium small">کل پرسش‌نامه‌ها</span>
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-journal-text fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalQuestionnaires</h3>
                    <span class="badge bg-light text-secondary border">فعال</span>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-custom h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-medium small">کل لینک‌های صادره</span>
                    <div class="stat-icon bg-info-subtle text-info">
                        <i class="bi bi-link-45deg fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalTokens</h3>
                    <span class="badge bg-light text-secondary border">مخاطبان هدف</span>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-custom h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-medium small">پاسخ‌های ثبت‌شده کامل</span>
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalCompleted</h3>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        نرخ مشارکت: @(Model.TotalTokens > 0 ? Math.Round((double)Model.TotalCompleted / Model.TotalTokens * 100, 1) : 0)٪
                    </span>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-custom h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-medium small">در انتظار / منقضی شده</span>
                    <div class="stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalPending</h3>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                        @Model.TotalExpired منقضی
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Questionnaires List Table Card -->
    <div class="card card-custom mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary fs-5"></i>
                <h5 class="mb-0 fw-bold">فهرست پرسش‌نامه‌های سازمانی</h5>
            </div>
            <a href="@Url.Action("Create", "Admin")" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i>
                <span>پرسش‌نامه جدید</span>
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.Questionnaires == null || Model.Questionnaires.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="stat-icon bg-light text-muted mx-auto mb-3" style="width: 4rem; height: 4rem;">
                        <i class="bi bi-inbox fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark">هنوز هیچ پرسش‌نامه‌ای در سامانه تعریف نشده است</h6>
                    <p class="text-muted small mb-3">جهت شروع فرآیند ارزیابی سازمانی بر روی دکمه «تعریف پرسش‌نامه جدید» کلیک فرمایید.</p>
                    <a href="@Url.Action("Create", "Admin")" class="btn btn-primary btn-sm px-3">
                        <i class="bi bi-plus-lg me-1"></i> ایجاد اولین پرسش‌نامه
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>عنوان پرسش‌نامه</th>
                                <th class="text-center">محدودیت زمانی</th>
                                <th class="text-center">لینک‌های صادره</th>
                                <th class="text-center">تکمیل شده</th>
                                <th class="text-center">نرخ مشارکت</th>
                                <th class="text-start">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model.Questionnaires)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@q.Title</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 350px;">@(string.IsNullOrWhiteSpace(q.Description) ? "بدون توضیحات" : q.Description)</small>
                                    </td>
                                    <td class="text-center">
                                        @if (q.TimeLimitMinutes.HasValue && q.TimeLimitMinutes.Value > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                                                <i class="bi bi-stopwatch me-1"></i> @q.TimeLimitMinutes دقیقه
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border">نامحدود</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@q.TotalTokens</td>
                                    <td class="text-center text-success fw-bold">@q.CompletedCount</td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @q.CompletionRate%"></div>
                                            </div>
                                            <span class="small fw-bold">@q.CompletionRate٪</span>
                                        </div>
                                    </td>
                                    <td class="text-start">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", "Admin", new { id = q.Id })" class="btn btn-outline-primary" title="مدیریت لینک‌ها و مخاطبان">
                                                <i class="bi bi-people me-1"></i> لینک‌ها و مخاطبان
                                            </a>
                                            <a href="@Url.Action("Analytics", "Admin", new { id = q.Id })" class="btn btn-outline-info" title="تحلیل و آمار">
                                                <i class="bi bi-bar-chart-line me-1"></i> آمار و تحلیل
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent Audit Logs Card -->
    <div class="card card-custom">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-primary fs-5"></i>
                <h5 class="mb-0 fw-bold">رویدادها و لاگ‌های امنیتی اخیر (Audit Trail)</h5>
            </div>
            <a href="@Url.Action("AuditLogs", "Admin")" class="btn btn-sm btn-link text-decoration-none">
                مشاهده تمام لاگ‌ها <i class="bi bi-arrow-left"></i>
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentLogs == null || Model.RecentLogs.Count == 0)
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-shield-slash fs-3 d-block mb-1"></i>
                    تاکنون رویدادی ثبت نشده است. با ورود یا پاسخ مخاطبان، لاگ‌های امنیتی در این قسمت نمایش داده می‌شوند.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-sm mb-0">
                        <thead>
                            <tr>
                                <th>زمان دقیق</th>
                                <th>نوع عملیات</th>
                                <th>آدرس IP</th>
                                <th>پرسش‌نامه / توکن</th>
                                <th>جزئیات رویداد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.RecentLogs)
                            {
                                <tr>
                                    <td class="text-nowrap small text-muted">@log.Timestamp.ToString("yyyy/MM/dd HH:mm:ss")</td>
                                    <td>
                                        @if (log.ActionType == "FormSubmitted")
                                        {
                                            <span class="badge bg-success-subtle text-success">ثبت پاسخ</span>
                                        }
                                        else if (log.ActionType == "PageOpened")
                                        {
                                            <span class="badge bg-primary-subtle text-primary">ورود و بازگشایی</span>
                                        }
                                        else if (log.ActionType == "TokenExpired")
                                        {
                                            <span class="badge bg-danger-subtle text-danger">انقضای زمان</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">@log.ActionType</span>
                                        }
                                    </td>
                                    <td class="text-nowrap font-monospace small">@log.IPAddress</td>
                                    <td class="small">@(log.TokenId.HasValue ? ("توکن #" + log.TokenId) : "-")</td>
                                    <td class="small text-truncate" style="max-width: 350px;">@log.Details</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
