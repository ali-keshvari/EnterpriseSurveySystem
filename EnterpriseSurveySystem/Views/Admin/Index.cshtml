@model EnterpriseSurveySystem.Models.ViewModels.AdminDashboardViewModel
@{
    ViewBag.Title = "داشبورد و آمار کل";
}

<div class="flex flex-col w-full space-y-8">
    <!-- Page Header & Action Controls Bar matching Stitch _2 & _3 -->
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 pb-6 border-b border-surface-container-high">
        <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-primary-container text-on-primary shadow-sm">
                    <span class="material-symbols-outlined text-xl">monitoring</span>
                </span>
                <h1 class="font-headline-lg text-headline-lg text-on-surface font-bold">داشبورد و آمار کل پرسش‌نامه‌های سازمانی</h1>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary-container/15 text-tertiary font-label-sm text-label-sm font-bold">
                    <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
                    سامانه برخط و عملیاتی
                </span>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-3xl">
                پایش لحظه‌ای نرخ مشارکت، ایجاد پرسش‌نامه، مدیریت توکن‌های یکبارمصرف و نظارت بر رویدادهای زمانی سیستم
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a href="@Url.Action("Create", "Admin")" class="inline-flex items-center gap-2 bg-primary-container text-on-primary px-4 py-2.5 rounded-xl font-label-md text-label-md hover:bg-primary shadow-sm hover:shadow-md transition-all active:scale-[0.98]">
                <span class="material-symbols-outlined text-lg">add_circle</span>
                <span>تعریف پرسش‌نامه جدید</span>
            </a>
            <a href="@Url.Action("AuditLogs", "Admin")" class="inline-flex items-center gap-2 bg-surface-container-highest text-on-surface px-4 py-2.5 rounded-xl font-label-md text-label-md hover:bg-surface-container-high transition-all border border-surface-container">
                <span class="material-symbols-outlined text-lg text-primary">history</span>
                <span>لاگ‌های زمانی سیستم</span>
            </a>
        </div>
    </div>

    <!-- 4-Card KPI Strip matching Stitch _2 Elevation & Tonal Rules -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Questionnaires -->
        <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between relative overflow-hidden group hover:shadow transition-shadow">
            <div class="flex items-center justify-between z-10 mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant font-medium">کل پرسش‌نامه‌ها</span>
                <div class="w-9 h-9 rounded-lg bg-surface-container-high flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-xl">ballot</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between z-10">
                <span class="font-headline-lg text-headline-lg text-on-surface font-extrabold tabular-nums">@Model.TotalQuestionnaires</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-2 py-0.5 rounded-md">سازمانی</span>
            </div>
            <div class="w-full bg-surface-container-high h-1.5 rounded-full mt-3 overflow-hidden">
                <div class="bg-primary h-full rounded-full" style="width: @(Model.TotalQuestionnaires > 0 ? "100%" : "0%")"></div>
            </div>
        </div>

        <!-- Card 2: Generated Tokens -->
        <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between relative overflow-hidden group hover:shadow transition-shadow">
            <div class="flex items-center justify-between z-10 mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant font-medium">کل لینک‌های صادره</span>
                <div class="w-9 h-9 rounded-lg bg-surface-container-high flex items-center justify-center text-on-surface">
                    <span class="material-symbols-outlined text-xl">vpn_key</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between z-10">
                <span class="font-headline-lg text-headline-lg text-on-surface font-extrabold tabular-nums">@Model.TotalTokens</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-2 py-0.5 rounded-md">مخاطبان هدف</span>
            </div>
            <div class="w-full bg-surface-container-high h-1.5 rounded-full mt-3 overflow-hidden">
                <div class="bg-secondary h-full rounded-full" style="width: @(Model.TotalTokens > 0 ? "100%" : "0%")"></div>
            </div>
        </div>

        <!-- Card 3: Completed Surveys -->
        <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between relative overflow-hidden group hover:shadow transition-shadow">
            <div class="flex items-center justify-between z-10 mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant font-medium">پاسخ‌های ثبت‌شده کامل</span>
                <div class="w-9 h-9 rounded-lg bg-tertiary-container/15 flex items-center justify-center text-tertiary">
                    <span class="material-symbols-outlined text-xl">check_circle</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between z-10">
                <span class="font-headline-lg text-headline-lg text-tertiary font-extrabold tabular-nums">@Model.TotalCompleted</span>
                <span class="font-label-sm text-label-sm text-tertiary bg-tertiary-container/15 px-2 py-0.5 rounded-md font-bold">@Model.OverallCompletionRate% مشارکت</span>
            </div>
            <div class="w-full bg-surface-container-high h-1.5 rounded-full mt-3 overflow-hidden">
                <div class="bg-tertiary h-full rounded-full" style="width: @Model.OverallCompletionRate%"></div>
            </div>
        </div>

        <!-- Card 4: Pending / Expired -->
        <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between relative overflow-hidden group hover:shadow transition-shadow">
            <div class="flex items-center justify-between z-10 mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant font-medium">در انتظار / منقضی شده</span>
                <div class="w-9 h-9 rounded-lg bg-surface-container-high flex items-center justify-center text-outline">
                    <span class="material-symbols-outlined text-xl">hourglass_empty</span>
                </div>
            </div>
            <div class="flex items-baseline justify-between z-10">
                <div class="flex items-center gap-2">
                    <span class="font-headline-md text-headline-md text-outline font-bold tabular-nums">@Model.TotalPending در انتظار</span>
                    <span class="text-outline-variant">/</span>
                    <span class="font-headline-md text-headline-md text-error font-bold tabular-nums">@Model.TotalExpired منقضی</span>
                </div>
            </div>
            <div class="w-full bg-surface-container-high h-1.5 rounded-full mt-3 overflow-hidden flex">
                <div class="bg-outline h-full" style="width: @(Model.TotalTokens > 0 ? (Model.TotalPending * 100 / Model.TotalTokens) : 0)%"></div>
                <div class="bg-error h-full" style="width: @(Model.TotalTokens > 0 ? (Model.TotalExpired * 100 / Model.TotalTokens) : 0)%"></div>
            </div>
        </div>
    </div>

    <!-- Questionnaires Management Table -->
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container overflow-hidden">
        <div class="p-5 sm:px-6 border-b border-surface-container-high flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-primary text-xl">table_chart</span>
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">فهرست پرسش‌نامه‌های سازمانی</h2>
                    <p class="font-label-sm text-label-sm text-on-surface-variant">مدیریت لینک‌های اختصاصی، محدودیت زمانی و پیگیری مشارکت کارکنان</p>
                </div>
            </div>
            <a href="@Url.Action("Create", "Admin")" class="inline-flex items-center gap-2 bg-primary-container text-on-primary font-label-md text-label-md px-4 py-2 rounded-xl shadow-sm hover:bg-primary transition">
                <span class="material-symbols-outlined text-lg">add</span>
                <span>پرسش‌نامه جدید</span>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right font-body-sm text-body-sm border-collapse">
                <thead class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md border-b border-surface-container-high">
                    <tr>
                        <th class="py-3.5 px-6 font-semibold">شناسه و عنوان پرسش‌نامه</th>
                        <th class="py-3.5 px-4 font-semibold">محدودیت زمانی</th>
                        <th class="py-3.5 px-4 font-semibold text-center">مخاطبان هدف</th>
                        <th class="py-3.5 px-4 font-semibold text-center">لینک‌های صادره</th>
                        <th class="py-3.5 px-4 font-semibold text-center">تکمیل شده</th>
                        <th class="py-3.5 px-6 font-semibold">نرخ مشارکت</th>
                        <th class="py-3.5 px-6 font-semibold text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container text-on-surface">
                    @if (Model.Questionnaires.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-on-surface-variant font-body-md">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <span class="material-symbols-outlined text-4xl text-outline-variant">assignment_late</span>
                                    <span class="font-semibold">هنوز هیچ پرسش‌نامه‌ای در سامانه تعریف نشده است.</span>
                                    <span class="text-xs text-outline">جهت شروع فرآیند ارزیابی، بر روی دکمه «تعریف پرسش‌نامه جدید» کلیک فرمایید.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Questionnaires)
                        {
                            <tr class="hover:bg-surface-container-low/40 transition">
                                <td class="py-4 px-6 font-semibold text-on-surface">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg bg-surface-container-high text-primary flex items-center justify-center font-bold text-xs">
                                            #@item.Id
                                        </div>
                                        <div>
                                            <a href="@Url.Action("Details", "Admin", new { id = item.Id })" class="hover:text-primary transition font-bold text-on-surface text-sm">
                                                @item.Title
                                            </a>
                                            <p class="font-label-sm text-label-sm text-on-surface-variant font-normal">ایجاد شده در @item.CreatedAt.ToString("yyyy/MM/dd")</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-on-surface">
                                    @if (item.TimeLimitMinutes.HasValue && item.TimeLimitMinutes.Value > 0)
                                    {
                                        <span class="inline-flex items-center gap-1 text-on-surface bg-surface-container-high px-2.5 py-1 rounded-lg font-label-sm text-label-sm font-semibold border border-surface-container">
                                            <span class="material-symbols-outlined text-xs text-primary">timer</span>
                                            <span>@item.TimeLimitMinutes دقیقه</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-on-surface-variant font-label-sm text-label-sm">نامحدود</span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-center tabular-nums font-medium">@item.TargetCount</td>
                                <td class="py-4 px-4 text-center tabular-nums font-bold text-on-surface">@item.GeneratedTokensCount</td>
                                <td class="py-4 px-4 text-center tabular-nums font-bold text-tertiary">@item.CompletedCount</td>
                                <td class="py-4 px-6">
                                    <div class="w-full max-w-xs">
                                        <div class="flex items-center justify-between font-label-sm text-label-sm mb-1">
                                            <span class="text-on-surface-variant font-bold">@item.CompletionPercentage%</span>
                                            <span class="text-on-surface-variant">@item.CompletedCount از @item.GeneratedTokensCount</span>
                                        </div>
                                        <div class="w-full bg-surface-container-high h-2 rounded-full overflow-hidden">
                                            <div class="bg-primary h-full rounded-full" style="width: @item.CompletionPercentage%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="@Url.Action("Details", "Admin", new { id = item.Id })" class="inline-flex items-center gap-1 bg-surface-container-high hover:bg-surface-container-highest text-on-surface px-3 py-1.5 rounded-lg font-label-sm text-label-sm font-semibold transition" title="مدیریت لینک‌ها">
                                            <span class="material-symbols-outlined text-sm">link</span>
                                            <span>لینک‌ها</span>
                                        </a>
                                        <a href="@Url.Action("Analytics", "Admin", new { id = item.Id })" class="inline-flex items-center gap-1 bg-primary-container text-on-primary hover:bg-primary px-3 py-1.5 rounded-lg font-label-sm text-label-sm font-semibold transition" title="تحلیل آماری">
                                            <span class="material-symbols-outlined text-sm">insights</span>
                                            <span>تحلیل</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Audit Trail Feed matching Stitch Screen 3 -->
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container overflow-hidden">
        <div class="p-5 sm:px-6 border-b border-surface-container-high flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-primary text-xl">security</span>
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">رویدادها و لاگ‌های امنیتی اخیر (Audit Trail)</h2>
                    <p class="font-label-sm text-label-sm text-on-surface-variant">ثبت دقیق لحظه‌ای رویدادهای بازگشایی لینک، انقضا و ارسال فرم</p>
                </div>
            </div>
            <a href="@Url.Action("AuditLogs", "Admin")" class="font-label-md text-label-md font-bold text-primary hover:text-primary-hover flex items-center gap-1">
                <span>مشاهده تمام لاگ‌ها</span>
                <span class="material-symbols-outlined text-sm">arrow_left</span>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-right font-body-sm text-body-sm border-collapse">
                <thead class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md border-b border-surface-container-high">
                    <tr>
                        <th class="py-3 px-6 font-semibold">زمان دقیق</th>
                        <th class="py-3 px-4 font-semibold">نوع عملیات</th>
                        <th class="py-3 px-4 font-semibold">آدرس IP</th>
                        <th class="py-3 px-4 font-semibold">توکن / شناسه</th>
                        <th class="py-3 px-6 font-semibold">جزئیات رویداد</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container text-on-surface">
                    @if (Model.RecentLogs.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="py-10 text-center text-on-surface-variant font-body-md">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <span class="material-symbols-outlined text-3xl text-outline-variant">history_toggle_off</span>
                                    <span>تا کنون رویدادی ثبت نشده است. با ورود یا پاسخ مخاطبان به پرسش‌نامه‌ها، لاگ‌های امنیتی در این قسمت نمایش داده می‌شوند.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model.RecentLogs)
                        {
                            <tr class="hover:bg-surface-container-low/40 transition">
                                <td class="py-3 px-6 text-on-surface font-mono text-xs tabular-nums">
                                    @log.Timestamp.ToString("yyyy/MM/dd HH:mm:ss")
                                </td>
                                <td class="py-3 px-4">
                                    @switch (log.ActionType)
                                    {
                                        case "PageOpened":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-surface-container-high text-primary border border-surface-container">
                                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                                <span>ورود اولیه به فرم</span>
                                            </span>
                                            break;
                                        case "FormSubmitted":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-tertiary-container/15 text-tertiary border border-tertiary-container/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                                                <span>ثبت نهایی پاسخ‌ها</span>
                                            </span>
                                            break;
                                        case "TokenExpired":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-error-container/20 text-error border border-error-container">
                                                <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                                                <span>انقضای مهلت لینک</span>
                                            </span>
                                            break;
                                        case "TokensGenerated":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-primary-container/10 text-primary border border-primary-container/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                                <span>تولید توکن‌ها</span>
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold bg-surface-container text-on-surface border border-surface-container-high">
                                                <span>@log.ActionPersianTitle</span>
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-3 px-4 text-on-surface font-mono text-xs">@log.IPAddress</td>
                                <td class="py-3 px-4 font-mono text-on-surface text-xs">
                                    @(string.IsNullOrEmpty(log.TokenGuid) ? "-" : log.TokenGuid.Substring(0, Math.Min(12, log.TokenGuid.Length)) + "...")
                                </td>
                                <td class="py-3 px-6 text-on-surface-variant font-body-sm text-body-sm">@log.Details</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
