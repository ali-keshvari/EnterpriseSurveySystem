@model EnterpriseSurveySystem.Models.ViewModels.CreateQuestionnaireViewModel
@{
    ViewBag.Title = "سازنده فرم و تعریف سوالات";
}

<div class="max-w-5xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-surface-container-high">
        <div>
            <h1 class="font-headline-lg text-headline-lg font-bold text-on-surface">سازنده فرم و تنظیمات ارزیابی</h1>
            <p class="font-label-sm text-label-sm text-on-surface-variant mt-1">تعریف ساختار پرسش‌نامه، قوانین زمان‌بندی و سوالات تخصصی</p>
        </div>
        <a href="@Url.Action("Index", "Admin")" class="inline-flex items-center gap-1.5 font-label-md text-label-md text-on-surface hover:text-primary bg-surface-container-lowest border border-surface-container px-3.5 py-2 rounded-xl shadow-sm transition">
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
            <span>بازگشت به داشبورد</span>
        </a>
    </div>

    <!-- Main Creation Form -->
    <form id="createSurveyForm" method="post" action="@Url.Action("Create", "Admin")">
        @Html.AntiForgeryToken()

        <!-- Section 1: Basic Survey Settings (Stitch _1 layout) -->
        <div class="bg-surface-container-lowest border border-surface-container rounded-2xl p-6 shadow-sm mb-8 space-y-6">
            <div class="flex items-center gap-2.5 pb-3 border-b border-surface-container">
                <span class="material-symbols-outlined text-primary text-xl">tune</span>
                <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">تنظیمات پایه و پارامترهای اجرایی</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Title -->
                <div class="md:col-span-2">
                    <label class="block font-label-md text-label-md font-semibold text-on-surface mb-2">عنوان پرسش‌نامه سازمانی *</label>
                    <input type="text" name="Title" value="@Model.Title" required placeholder="مثال: نظرسنجی رضایت شغلی و ارزیابی عملکرد فصلی" class="w-full font-body-md text-body-md p-3 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface" />
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label class="block font-label-md text-label-md font-semibold text-on-surface mb-2">توضیحات و راهنمای تکمیل برای مخاطبان</label>
                    <textarea name="Description" rows="3" placeholder="توضیحاتی در خصوص حریم خصوصی، ناشناس بودن و هدف نظرسنجی..." class="w-full font-body-md text-body-md p-3 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface leading-relaxed">@Model.Description</textarea>
                </div>

                <!-- Target Respondents Count -->
                <div>
                    <label class="block font-label-md text-label-md font-semibold text-on-surface mb-2">تعداد مخاطبان هدف (تعداد توکن‌های یکبارمصرف)</label>
                    <div class="relative">
                        <input type="number" name="TargetRespondentsCount" value="@Model.TargetRespondentsCount" min="1" max="5000" class="w-full font-body-md text-body-md p-3 pr-10 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface tabular-nums" />
                        <span class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant text-lg">group</span>
                    </div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1">تعداد لینک‌های اختصاصی که بلافاصله پس از ساخت ایجاد می‌گردند.</p>
                </div>

                <!-- Time Limit Minutes -->
                <div>
                    <label class="block font-label-md text-label-md font-semibold text-on-surface mb-2">محدودیت زمانی پاسخ‌گویی (دقیقه)</label>
                    <div class="relative">
                        <input type="number" name="TimeLimitMinutes" value="@Model.TimeLimitMinutes" min="1" max="180" placeholder="مثال: ۵ (برای ۵ دقیقه)" class="w-full font-body-md text-body-md p-3 pr-10 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface tabular-nums" />
                        <span class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant text-lg">timer</span>
                    </div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1">تایمر دقیقاً از لحظه بازگشایی لینک توسط مخاطب فعال می‌شود.</p>
                </div>
            </div>

            <!-- Auto-generate toggle -->
            <div class="pt-2">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="AutoGenerateTokens" value="true" checked class="w-4 h-4 text-primary rounded border-surface-container-high focus:ring-primary" />
                    <span class="font-label-md text-label-md font-semibold text-on-surface">تولید خودکار لینک‌های اختصاصی بر اساس تعداد مخاطبان هدف بلافاصله پس از ذخیره</span>
                </label>
            </div>
        </div>

        <!-- Section 2: Questions Definition -->
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">help_outline</span>
                    <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">بانک سوالات پرسش‌نامه</h2>
                </div>
                <button type="button" id="addQuestionBtn" class="inline-flex items-center gap-1.5 bg-surface-container-high hover:bg-primary-container/10 hover:text-primary text-on-surface font-label-md text-label-md font-semibold px-4 py-2 rounded-xl border border-surface-container transition">
                    <span class="material-symbols-outlined text-sm">add</span>
                    <span>افزودن سوال جدید</span>
                </button>
            </div>

            <div id="questionsContainer" class="space-y-5">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <div class="question-row bg-surface-container-lowest border border-surface-container rounded-2xl p-5 shadow-sm space-y-4 transition">
                        <div class="flex items-center justify-between pb-3 border-b border-surface-container">
                            <div class="flex items-center gap-2">
                                <span class="q-index-pill w-7 h-7 rounded-lg bg-primary-container/10 text-primary font-bold text-xs flex items-center justify-center">
                                    @(i + 1)
                                </span>
                                <span class="font-label-md text-label-md font-bold text-on-surface">پرسش شماره @(i + 1)</span>
                            </div>
                            <button type="button" class="remove-q-btn text-error hover:text-error/80 p-1.5 rounded-lg hover:bg-error-container/20 transition" title="حذف این سوال">
                                <span class="material-symbols-outlined text-base">delete</span>
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="md:col-span-2">
                                <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">متن سوال *</label>
                                <input type="text" name="Questions[@i].QuestionText" value="@q.QuestionText" required placeholder="متن کامل سوال ارزیابی..." class="w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface" />
                            </div>

                            <div>
                                <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">نوع سوال</label>
                                <select name="Questions[@i].QuestionType" class="q-type-select w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high bg-surface-container-lowest text-on-surface focus:border-primary focus:ring-1 focus:ring-primary">
                                    <option value="Testy" @(q.QuestionType == "Testy" ? "selected" : "")>تک‌گزینه‌ای (Radio)</option>
                                    <option value="MultiSelect" @(q.QuestionType == "MultiSelect" ? "selected" : "")>چندگزینه‌ای (Checkbox)</option>
                                    <option value="Boolean" @(q.QuestionType == "Boolean" ? "selected" : "")>دوگزینه‌ای (بله / خیر)</option>
                                    <option value="Select" @(q.QuestionType == "Select" ? "selected" : "")>منوی کشویی (Dropdown)</option>
                                    <option value="Tashrihi" @(q.QuestionType == "Tashrihi" ? "selected" : "")>تشریحی / متنی</option>
                                </select>
                            </div>

                            <div class="q-options-container md:col-span-3 @(q.QuestionType == "Tashrihi" || q.QuestionType == "Boolean" ? "hidden" : "")">
                                <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">گزینه‌های پاسخ (هر گزینه در یک سطر یا با ویرگول جدا شود)</label>
                                <textarea name="Questions[@i].OptionsRaw" rows="3" placeholder="گزینه ۱&#10;گزینه ۲&#10;گزینه ۳" class="w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface">@q.OptionsRaw</textarea>
                            </div>
                        </div>

                        <div class="pt-2 flex items-center justify-between border-t border-surface-container">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" name="Questions[@i].IsRequired" value="true" @(q.IsRequired ? "checked" : "") class="w-4 h-4 text-primary rounded border-surface-container-high focus:ring-primary" />
                                <span class="font-label-sm text-label-sm text-on-surface">پاسخ به این سوال الزامی باشد</span>
                            </label>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Submit Footer -->
        <div class="mt-8 bg-surface-container-lowest border border-surface-container rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <span class="font-label-sm text-label-sm text-on-surface-variant">پس از ذخیره، لینک‌های اختصاصی مخاطبان به صورت خودکار تولید و آماده اشتراک‌گذاری خواهند شد.</span>
            <button type="submit" class="inline-flex items-center gap-2 bg-primary-container text-on-primary hover:bg-primary font-label-md text-label-md font-bold px-6 py-2.5 rounded-xl shadow-sm transition">
                <span class="material-symbols-outlined text-base">save</span>
                <span>ذخیره و تولید لینک‌های مخاطبان</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const container = document.getElementById("questionsContainer");
            const addBtn = document.getElementById("addQuestionBtn");

            function reindexQuestions() {
                const rows = container.querySelectorAll(".question-row");
                rows.forEach(function (row, idx) {
                    row.querySelector(".q-index-pill").textContent = (idx + 1);
                    row.querySelector("input[name*='QuestionText']").name = "Questions[" + idx + "].QuestionText";
                    row.querySelector("select[name*='QuestionType']").name = "Questions[" + idx + "].QuestionType";
                    const optionsTextarea = row.querySelector("textarea[name*='OptionsRaw']");
                    if (optionsTextarea) optionsTextarea.name = "Questions[" + idx + "].OptionsRaw";
                    const reqCheckbox = row.querySelector("input[name*='IsRequired']");
                    if (reqCheckbox) reqCheckbox.name = "Questions[" + idx + "].IsRequired";
                });
            }

            function bindRowEvents(row) {
                const typeSelect = row.querySelector(".q-type-select");
                const optionsDiv = row.querySelector(".q-options-container");
                const removeBtn = row.querySelector(".remove-q-btn");

                if (typeSelect && optionsDiv) {
                    typeSelect.addEventListener("change", function () {
                        if (this.value === "Tashrihi" || this.value === "Boolean") {
                            optionsDiv.classList.add("hidden");
                        } else {
                            optionsDiv.classList.remove("hidden");
                        }
                    });
                }

                if (removeBtn) {
                    removeBtn.addEventListener("click", function () {
                        if (container.querySelectorAll(".question-row").length > 1) {
                            row.remove();
                            reindexQuestions();
                        } else {
                            alert("پرسش‌نامه باید حداقل دارای ۱ سوال باشد.");
                        }
                    });
                }
            }

            container.querySelectorAll(".question-row").forEach(bindRowEvents);

            addBtn.addEventListener("click", function () {
                const idx = container.querySelectorAll(".question-row").length;
                const newRow = document.createElement("div");
                newRow.className = "question-row bg-surface-container-lowest border border-surface-container rounded-2xl p-5 shadow-sm space-y-4 transition";
                newRow.innerHTML = `
                    <div class="flex items-center justify-between pb-3 border-b border-surface-container">
                        <div class="flex items-center gap-2">
                            <span class="q-index-pill w-7 h-7 rounded-lg bg-primary-container/10 text-primary font-bold text-xs flex items-center justify-center">
                                ${idx + 1}
                            </span>
                            <span class="font-label-md text-label-md font-bold text-on-surface">پرسش شماره ${idx + 1}</span>
                        </div>
                        <button type="button" class="remove-q-btn text-error hover:text-error/80 p-1.5 rounded-lg hover:bg-error-container/20 transition" title="حذف این سوال">
                            <span class="material-symbols-outlined text-base">delete</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="md:col-span-2">
                            <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">متن سوال *</label>
                            <input type="text" name="Questions[${idx}].QuestionText" required placeholder="متن کامل سوال ارزیابی..." class="w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface" />
                        </div>

                        <div>
                            <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">نوع سوال</label>
                            <select name="Questions[${idx}].QuestionType" class="q-type-select w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high bg-surface-container-lowest text-on-surface focus:border-primary focus:ring-1 focus:ring-primary">
                                <option value="Testy">تک‌گزینه‌ای (Radio)</option>
                                <option value="MultiSelect">چندگزینه‌ای (Checkbox)</option>
                                <option value="Boolean">دوگزینه‌ای (بله / خیر)</option>
                                <option value="Select">منوی کشویی (Dropdown)</option>
                                <option value="Tashrihi">تشریحی / متنی</option>
                            </select>
                        </div>

                        <div class="q-options-container md:col-span-3">
                            <label class="block font-label-sm text-label-sm font-semibold text-on-surface mb-1.5">گزینه‌های پاسخ (هر گزینه در یک سطر)</label>
                            <textarea name="Questions[${idx}].OptionsRaw" rows="3" placeholder="عالی&#10;خوب&#10;متوسط&#10;ضعیف" class="w-full font-body-md text-body-md p-2.5 rounded-xl border border-surface-container-high focus:border-primary focus:ring-1 focus:ring-primary bg-surface-container-lowest text-on-surface"></textarea>
                        </div>
                    </div>

                    <div class="pt-2 flex items-center justify-between border-t border-surface-container">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" name="Questions[${idx}].IsRequired" value="true" checked class="w-4 h-4 text-primary rounded border-surface-container-high focus:ring-primary" />
                            <span class="font-label-sm text-label-sm text-on-surface">پاسخ به این سوال الزامی باشد</span>
                        </label>
                    </div>
                `;
                container.appendChild(newRow);
                bindRowEvents(newRow);
            });
        })();
    </script>
}
