@model EnterpriseSurveySystem.Models.ViewModels.CreateQuestionnaireViewModel
@{
    ViewBag.Title = "سازنده فرم و سوالات";
}

<style>
    .filter-dropdown-menu {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 #f8fafc;
    }
    .filter-dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }
    .filter-dropdown-menu::-webkit-scrollbar-track {
        background: #f8fafc;
    }
    .filter-dropdown-menu::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }
    .hover-row {
        transition: all 0.15s ease-in-out;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
    }
    .hover-row:hover {
        background-color: #f8fafc !important;
        border-color: #94a3b8 !important;
    }
    .hover-row.is-checked {
        background-color: #eff6ff !important;
        border-color: #3b82f6 !important;
    }
    .dep-level-1 {
        background-color: #f8fafc;
        border-right: 3px solid #0d6efd !important;
    }
    .dep-level-2 {
        border-right: 2px solid #0dcaf0 !important;
    }
    .dep-level-3 {
        border-right: 2px solid #6c757d !important;
    }
</style>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
        <div>
            <h4 class="fw-bold mb-1 text-dark">سازنده فرم و تعریف سوالات پرسش‌نامه</h4>
            <p class="text-muted mb-0 small">طراحی پرسش‌نامه سازمانی، تنظیم سقف زمانی پاسخ‌گویی و انتخاب مخاطبان از ساختار سازمانی</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-arrow-right"></i>
                <span>بازگشت به داشبورد</span>
            </a>
        </div>
    </div>

    @using (Html.BeginForm("Create", "Admin", FormMethod.Post, new { id = "createForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left/Main Column: Questionnaire Info, Questions List, & Audience Selection -->
            <div class="col-12 col-lg-8">
                <!-- Questionnaire Basic Settings Card -->
                <div class="card card-custom mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>۱. اطلاعات پایه پرسش‌نامه</span>
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">عنوان پرسش‌نامه <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-lg", placeholder = "مثال: سنجش رضایت شغلی پرسنل - زمستان ۱۴۰۳", required = "required" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-bold">توضیحات و راهنمای شرکت در ارزیابی</label>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3", placeholder = "توضیحات لازم، اهداف ارزیابی و راهنمایی مخاطبان جهت پاسخ‌گویی دقیق..." })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <!-- Audience Selection Card (Departments, Positions, Persons) -->
                <div class="card card-custom mb-4 border-primary-subtle shadow-sm">
                    <div class="card-header bg-primary-subtle py-3 border-bottom d-flex align-items-center justify-content-between">
                        <h6 class="mb-0 fw-bold text-primary d-flex align-items-center gap-2">
                            <i class="bi bi-people-fill"></i>
                            <span>۲. انتخاب مخاطبان سازمانی (دپارتمان، سمت، پرسنل)</span>
                        </h6>
                        <span class="badge bg-primary text-white rounded-pill px-3 py-1" id="audienceSummaryBadge">
                            ۰ نفر انتخاب شده
                        </span>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small mb-3">
                            مخاطبان این پرسش‌نامه را با انتخاب دپارتمان‌ها، سمت‌ها یا پرسنل فعال مشخص فرمایید. لینک‌های اختصاصی مستقیماً برای این افراد صادر خواهد شد:
                        </p>

                        <div class="row g-3">
                            <!-- Dropdown 1: Departments (Tree View) -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between border-bottom">
                                        <span class="fw-bold small text-dark"><i class="bi bi-diagram-3-fill me-1 text-primary"></i> ۱. ساختار درختی دپارتمان‌ها</span>
                                        <div class="form-check form-check-inline m-0">
                                            <input class="form-check-input" type="checkbox" id="chkAllDepartments" />
                                            <label class="form-check-label small fw-semibold" for="chkAllDepartments">انتخاب همه</label>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-light border-bottom">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                            <input type="text" class="form-control border-start-0" id="searchDepartmentInput" placeholder="جستجوی دپارتمان یا واحد..." />
                                        </div>
                                    </div>
                                    <div class="card-body p-2 filter-dropdown-menu bg-white" id="departmentsList" style="height: 320px; overflow-y: auto;">
                                        <div class="text-center py-5 text-muted small">
                                            <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                                            <div>در حال دریافت ساختار درختی دپارتمان‌ها...</div>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-light py-2 px-3 text-muted small text-end fw-semibold border-top" id="depSelectedCount">
                                        ۰ دپارتمان انتخاب شده
                                    </div>
                                </div>
                            </div>

                            <!-- Dropdown 2: Positions -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between border-bottom">
                                        <span class="fw-bold small text-dark"><i class="bi bi-briefcase-fill me-1 text-primary"></i> ۲. سمت‌ها / پوزیشن‌ها</span>
                                        <div class="form-check form-check-inline m-0">
                                            <input class="form-check-input" type="checkbox" id="chkAllPositions" />
                                            <label class="form-check-label small fw-semibold" for="chkAllPositions">انتخاب همه</label>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-light border-bottom">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                            <input type="text" class="form-control border-start-0" id="searchPositionInput" placeholder="جستجوی سمت شغلی..." />
                                        </div>
                                    </div>
                                    <div class="card-body p-2 filter-dropdown-menu bg-white" id="positionsList" style="height: 320px; overflow-y: auto;">
                                        <div class="text-center py-5 text-muted small">در حال بارگذاری سمت‌ها...</div>
                                    </div>
                                    <div class="card-footer bg-light py-2 px-3 text-muted small text-end fw-semibold border-top" id="posSelectedCount">
                                        ۰ سمت انتخاب شده
                                    </div>
                                </div>
                            </div>

                            <!-- Dropdown 3: Persons -->
                            <div class="col-12 col-md-4">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between border-bottom">
                                        <span class="fw-bold small text-dark"><i class="bi bi-person-check-fill me-1 text-primary"></i> ۳. پرسنل فعال سازمانی</span>
                                        <div class="form-check form-check-inline m-0">
                                            <input class="form-check-input" type="checkbox" id="chkAllPersons" />
                                            <label class="form-check-label small fw-semibold" for="chkAllPersons">انتخاب همه</label>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-light border-bottom">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                            <input type="text" class="form-control border-start-0" id="searchPersonInput" placeholder="جستجوی نام یا کد پرسنلی..." />
                                        </div>
                                    </div>
                                    <div class="card-body p-2 filter-dropdown-menu bg-white" id="personsList" style="height: 320px; overflow-y: auto;">
                                        <div class="text-center py-5 text-muted small">در حال بارگذاری پرسنل...</div>
                                    </div>
                                    <div class="card-footer bg-light py-2 px-3 d-flex align-items-center justify-content-between small border-top">
                                        <span class="text-muted fw-semibold" id="totalPersonsFound">۰ نفر</span>
                                        <span class="badge bg-primary text-white px-2 py-1" id="personSelectedCount">۰ انتخاب</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Hidden container for SelectedPersonIds inputs -->
                        <div id="selectedPersonHiddenInputs"></div>
                    </div>
                </div>

                <!-- Questions Section -->
                <div class="card card-custom">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-question-circle text-primary"></i>
                            <span>۳. فهرست سوالات پرسش‌نامه</span>
                        </h6>
                        <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" id="btnAddQuestion">
                            <i class="bi bi-plus-lg"></i>
                            <span>افزودن سوال جدید</span>
                        </button>
                    </div>
                    <div class="card-body p-4">
                        <div id="questionsContainer">
                            <!-- Dynamic questions will be rendered here -->
                        </div>

                        <div class="text-center py-3 border rounded-3 bg-light mt-3 shadow-sm">
                            <button type="button" class="btn btn-outline-primary btn-lg d-inline-flex align-items-center gap-2 px-4 shadow-sm" id="btnAddQuestionBottom">
                                <i class="bi bi-plus-circle-fill fs-5"></i>
                                <span>افزودن سوال جدید (به انتهای فرم)</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Settings & Submit -->
            <div class="col-12 col-lg-4">
                <div class="card card-custom sticky-top" style="top: 85px;">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-sliders text-primary"></i>
                            <span>تنظیمات انتشار</span>
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">محدودیت زمانی پاسخ‌گویی (دقیقه)</label>
                            @Html.TextBoxFor(m => m.TimeLimitMinutes, new { @class = "form-control", type = "number", min = "1", max = "180", placeholder = "مثال: 5" })
                            <div class="form-text small text-muted">
                                محاسبه دقیق زمان از لحظه بازگشایی لینک توسط مخاطب. (خالی = نامحدود).
                            </div>
                        </div>

                        <!-- Show Respondent Name Toggle -->
                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <div class="form-check form-switch mb-1 d-flex align-items-center gap-2">
                                @Html.CheckBoxFor(m => m.ShowRespondentName, new { @class = "form-check-input m-0 cursor-pointer", role = "switch", id = "switchShowName" })
                                <label class="form-check-label fw-bold cursor-pointer text-dark" for="switchShowName">
                                    نمایش نام مخاطب در زمان پاسخ‌دهی
                                </label>
                            </div>
                            <div class="form-text small text-muted" style="font-size: 0.75rem; line-height: 1.6;">
                                در صورت فعال بودن، نام و کد پرسنلی به مخاطب در بالای صفحه آزمون نمایش داده می‌شود؛ در صورت خاموش بودن، پاسخ‌دهی به صورت ناشناس برای فرد ظاهر می‌گردد.
                            </div>
                        </div>

                        <!-- Audience Summary -->
                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="small fw-bold text-muted">مخاطبان انتخابی:</span>
                                <span class="badge bg-primary fs-6" id="sidebarSelectedCount">۰ نفر</span>
                            </div>
                            <small class="text-muted d-block" style="line-height: 1.6;">
                                تعداد لینک‌ها بر اساس پرسنل انتخابی صادر می‌شود و نیازی به وارد کردن دستی تعداد نیست.
                            </small>
                        </div>

                        <hr />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm d-flex align-items-center justify-content-center gap-2" id="btnSubmitCreate">
                                <i class="bi bi-check2-circle fs-5"></i>
                                <span>ذخیره و صدور لینک‌ها</span>
                            </button>
                            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">
                                انصراف
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Floating Quick-Add Button (Always visible on screen without scrolling) -->
    <div class="position-fixed bottom-0 start-0 m-4 z-3" style="z-index: 1050;">
        <button type="button" class="btn btn-primary btn-lg rounded-pill shadow-lg d-flex align-items-center gap-2 px-3 py-2.5 border border-2 border-white" id="btnFloatingAddQuestion" title="افزودن سریع سوال جدید بدون نیاز به اسکرول">
            <i class="bi bi-plus-circle-fill fs-5"></i>
            <span class="fw-bold small">افزودن سوال جدید</span>
        </button>
    </div>
</div>

@section scripts {
<script>
    var questionIndex = 0;
    var allDepartments = [];
    var allPositions = [];
    var allPersons = [];
    var selectedPersonIdsSet = new Set();

    var questionTypes = [
        { value: "Testy", text: "چهارگزینه‌ای (تک انتخابی)" },
        { value: "MultiSelect", text: "چند گزینه‌ای (انتخاب چندتایی)" },
        { value: "Boolean", text: "دو گزینه‌ای (بله / خیر)" },
        { value: "Select", text: "لیست کشویی (Dropdown)" },
        { value: "Tashrihi", text: "تشریحی / متنی (پاسخ باز)" }
    ];

    function addQuestion(text, type, options, isRequired, shouldScroll, imageUrl) {
        text = text || "";
        type = type || "Testy";
        options = options || "عالی\nخوب\nمتوسط\nضعیف";
        isRequired = isRequired !== undefined ? isRequired : true;
        shouldScroll = shouldScroll !== undefined ? shouldScroll : false;
        imageUrl = imageUrl || "";

        var currentIdx = questionIndex++;
        var showOptions = (type !== "Tashrihi" && type !== "Boolean");

        var html = `
        <div class="card border rounded-3 p-3 mb-3 bg-white question-item shadow-sm" data-index="${currentIdx}">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <span class="badge bg-primary rounded-pill px-3 py-1">سوال شماره ${currentIdx + 1}</span>
                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-question" title="حذف این سوال">
                    <i class="bi bi-trash3"></i>
                </button>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-8">
                    <label class="form-label fw-bold small">متن سوال <span class="text-danger">*</span></label>
                    <input type="text" name="Questions[${currentIdx}].QuestionText" value="${escapeHtml(text)}" class="form-control question-text-input" placeholder="متن سوال را وارد نمایید..." required />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold small">نوع سوال</label>
                    <select name="Questions[${currentIdx}].QuestionType" class="form-select select-qtype">
                        ${questionTypes.map(t => `<option value="${t.value}" ${t.value === type ? 'selected' : ''}>${t.text}</option>`).join('')}
                    </select>
                </div>

                <!-- Image Attachment Section -->
                <div class="col-12 question-image-block">
                    <label class="form-label fw-bold small d-flex align-items-center gap-1 mb-1">
                        <i class="bi bi-image text-primary"></i>
                        <span>تصویر پیوست صورت سوال (اختیاری)</span>
                    </label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm" style="max-width: 450px;">
                            <input type="file" class="form-control question-file-input" accept="image/*" />
                            <button type="button" class="btn btn-outline-primary btn-upload-image">
                                <i class="bi bi-cloud-arrow-up me-1"></i> بارگذاری
                            </button>
                        </div>
                        <input type="hidden" name="Questions[${currentIdx}].ImageUrl" class="question-image-url-input" value="${escapeHtml(imageUrl)}" />
                    </div>
                    
                    <div class="image-preview-wrapper mt-2 ${imageUrl ? '' : 'd-none'} p-2 border rounded bg-light d-inline-flex align-items-center gap-3">
                        <img src="${escapeHtml(imageUrl)}" class="img-thumbnail question-img-preview" style="max-height: 110px; max-width: 220px; object-fit: contain; background: #fff;" />
                        <div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle d-block mb-1 text-center"><i class="bi bi-check-circle me-1"></i>تصویر متصل شد</span>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-image d-flex align-items-center gap-1">
                                <i class="bi bi-trash"></i>
                                <span>حذف تصویر</span>
                            </button>
                        </div>
                    </div>
                    <div class="form-text small text-muted" style="font-size: 0.72rem;">
                        پشتیبانی از انواع فرمت‌های تصویری (JPG, PNG, WEBP, GIF) تا سقف ۵ مگابایت. تصویر به همراه متن سوال در آزمون نمایش داده می‌شود.
                    </div>
                </div>

                <div class="col-12 options-container" style="display: ${showOptions ? 'block' : 'none'};">
                    <label class="form-label fw-bold small">گزینه‌های پاسخ (هر گزینه در یک خط)</label>
                    <textarea name="Questions[${currentIdx}].OptionsRaw" rows="3" class="form-control font-monospace" placeholder="گزینه ۱&#10;گزینه ۲&#10;گزینه ۳">${escapeHtml(options)}</textarea>
                    <div class="form-text small text-muted">هر گزینه را در یک خط مجزا وارد نمایید.</div>
                </div>

                <div class="col-12 d-flex align-items-center justify-content-between pt-3 border-top mt-2">
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" name="Questions[${currentIdx}].IsRequired" value="true" ${isRequired ? 'checked' : ''} id="req_${currentIdx}">
                        <input type="hidden" name="Questions[${currentIdx}].IsRequired" value="false" />
                        <label class="form-check-label small fw-bold" for="req_${currentIdx}">پاسخ به این سوال الزامی است</label>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary btn-add-next-question d-flex align-items-center gap-1 shadow-sm" title="افزودن سوال جدید بلافاصله بعد از این سوال">
                        <i class="bi bi-plus-circle"></i>
                        <span>+ افزودن سوال بعدی</span>
                    </button>
                </div>
            </div>
        </div>`;

        var newCard = $(html);
        $('#questionsContainer').append(newCard);
        updateQuestionNumbers();

        if (shouldScroll) {
            $('html, body').animate({
                scrollTop: newCard.offset().top - 90
            }, 300);
            setTimeout(function() {
                newCard.find('.question-text-input').focus();
            }, 350);
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function updateQuestionNumbers() {
        $('#questionsContainer .question-item').each(function(i) {
            $(this).find('.badge').first().text('سوال شماره ' + (i + 1));
            $(this).find('input[name^="Questions["], select[name^="Questions["], textarea[name^="Questions["]').each(function() {
                var name = $(this).attr('name');
                if (name) {
                    var newName = name.replace(/Questions\[\d+\]/, 'Questions[' + i + ']');
                    $(this).attr('name', newName);
                }
            });
        });
    }

    // --- Audience Selection Functions (Tree Structure) ---
    function loadDepartments() {
        $.getJSON('@Url.Action("GetDepartments", "Admin")', function(res) {
            if (res.success && res.data) {
                allDepartments = res.data;
                renderDepartments(allDepartments);
            } else {
                $('#departmentsList').html('<div class="text-danger p-2 small">خطا در دریافت دپارتمان‌ها: ' + (res.message || '') + '</div>');
            }
        }).fail(function() {
            $('#departmentsList').html('<div class="text-danger p-2 small">عدم برقراری ارتباط با دیتابیس پرسنلی</div>');
        });
    }

    function renderDepartments(deps) {
        var filterText = $('#searchDepartmentInput').val() ? $('#searchDepartmentInput').val().trim().toLowerCase() : '';
        var html = '';

        if (!deps || deps.length === 0) {
            $('#departmentsList').html('<div class="text-muted p-4 small text-center">هیچ دپارتمان فعالی یافت نشد.</div>');
            return;
        }

        deps.forEach(function(d) {
            if (filterText && !d.DepNameFa.toLowerCase().includes(filterText)) {
                return;
            }

            var indentPx = Math.max(0, (d.DepLevel - 1)) * 18;
            var iconHtml = '';
            var levelClass = 'dep-level-' + d.DepLevel;

            if (d.DepLevel === 1) {
                iconHtml = '<i class="bi bi-building-fill text-primary me-2"></i>';
            } else if (d.DepLevel === 2) {
                iconHtml = '<span class="text-muted small me-1">└─</span><i class="bi bi-diagram-3-fill text-info me-1"></i>';
            } else {
                iconHtml = '<span class="text-muted small me-1">└──</span><i class="bi bi-circle-fill text-secondary me-1" style="font-size:0.35rem;"></i>';
            }

            html += `
            <div class="hover-row ${levelClass} p-2 mb-1 rounded shadow-none" 
                 style="margin-right: ${indentPx}px;" 
                 data-dep-id="${d.DepartmentId}" 
                 data-parent-id="${d.DepHdrId}" 
                 data-level="${d.DepLevel}">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center flex-grow-1">
                        <input class="form-check-input chk-dep m-0 me-2 cursor-pointer flex-shrink-0" 
                               type="checkbox" 
                               value="${d.DepartmentId}" 
                               id="dep_${d.DepartmentId}"
                               data-dep-id="${d.DepartmentId}"
                               data-parent-id="${d.DepHdrId}"
                               data-level="${d.DepLevel}">
                        <label class="form-check-label cursor-pointer m-0 d-flex align-items-center user-select-none" for="dep_${d.DepartmentId}">
                            ${iconHtml}
                            <span class="${d.DepLevel === 1 ? 'fw-bold text-dark' : (d.DepLevel === 2 ? 'fw-semibold text-dark' : 'text-secondary')}">${d.DepNameFa}</span>
                        </label>
                    </div>
                    <span class="badge ${d.DepLevel === 1 ? 'bg-primary-subtle text-primary' : 'bg-light text-muted'} border small ms-2 flex-shrink-0" style="font-size:0.65rem;">سطح ${d.DepLevel}</span>
                </div>
            </div>`;
        });

        $('#departmentsList').html(html || '<div class="text-muted p-4 small text-center">دپارتمانی با این نام یافت نشد.</div>');
    }

    function setChildDepartmentsChecked(parentId, isChecked) {
        $('.chk-dep[data-parent-id="' + parentId + '"]').each(function() {
            $(this).prop('checked', isChecked);
            if (isChecked) {
                $(this).closest('.hover-row').addClass('is-checked');
            } else {
                $(this).closest('.hover-row').removeClass('is-checked');
            }
            var childId = $(this).val();
            setChildDepartmentsChecked(childId, isChecked);
        });
    }

    function getSelectedDepartmentIds() {
        var ids = [];
        $('.chk-dep:checked').each(function() {
            ids.push(parseInt($(this).val()));
        });
        return ids;
    }

    function getSelectedPositionIds() {
        var ids = [];
        $('.chk-pos:checked').each(function() {
            ids.push(parseInt($(this).val()));
        });
        return ids;
    }

    function loadPositions() {
        var depIds = getSelectedDepartmentIds();
        $('#positionsList').html('<div class="text-center py-5 text-muted small"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>در حال بارگذاری سمت‌ها...</div></div>');

        $.ajax({
            url: '@Url.Action("GetPositions", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ departmentIds: depIds }),
            success: function(res) {
                if (res.success && res.data) {
                    allPositions = res.data;
                    renderPositions(allPositions);
                    $('#chkAllPositions').prop('checked', false);
                    updatePositionCount();
                    loadPersons();
                }
            }
        });
    }

    function renderPositions(positions) {
        var filterText = $('#searchPositionInput').val() ? $('#searchPositionInput').val().trim().toLowerCase() : '';
        var html = '';

        var filtered = positions.filter(function(p) {
            if (!filterText) return true;
            return (p.PositionNameFa && p.PositionNameFa.toLowerCase().includes(filterText)) ||
                   (p.DepartmentName && p.DepartmentName.toLowerCase().includes(filterText));
        });

        if (filtered.length === 0) {
            $('#positionsList').html('<div class="text-muted p-4 small text-center">سمتی یافت نشد.</div>');
            return;
        }

        filtered.forEach(function(p) {
            html += `
            <div class="hover-row p-2 mb-1 rounded">
                <div class="d-flex align-items-start">
                    <input class="form-check-input chk-pos m-0 me-2 mt-1 cursor-pointer flex-shrink-0" 
                           type="checkbox" 
                           value="${p.PositionId}" 
                           id="pos_${p.PositionId}">
                    <div class="flex-grow-1">
                        <label class="form-check-label cursor-pointer d-block fw-bold text-dark m-0" for="pos_${p.PositionId}">
                            ${p.PositionNameFa}
                        </label>
                        <div class="text-muted small mt-1 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                            <i class="bi bi-diagram-3 text-primary"></i>
                            <span>${p.DepartmentName || 'دپارتمان نامشخص'}</span>
                        </div>
                    </div>
                </div>
            </div>`;
        });

        $('#positionsList').html(html);
    }

    function loadPersons() {
        var depIds = getSelectedDepartmentIds();
        var posIds = getSelectedPositionIds();

        $('#personsList').html('<div class="text-center py-5 text-muted small"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>در حال بارگذاری پرسنل...</div></div>');

        $.ajax({
            url: '@Url.Action("GetPersons", "Admin")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ departmentIds: depIds, positionIds: posIds }),
            success: function(res) {
                if (res.success && res.data) {
                    allPersons = res.data;
                    renderPersons(allPersons);
                    $('#totalPersonsFound').text(allPersons.length + ' نفر');
                    $('#chkAllPersons').prop('checked', false);
                    updatePersonCount();
                }
            }
        });
    }

    function renderPersons(persons) {
        var filterText = $('#searchPersonInput').val() ? $('#searchPersonInput').val().trim().toLowerCase() : '';
        var html = '';

        var filtered = persons.filter(function(p) {
            if (!filterText) return true;
            return (p.FullName && p.FullName.toLowerCase().includes(filterText)) ||
                   (p.PersonelCode && p.PersonelCode.toString().includes(filterText)) ||
                   (p.PositionName && p.PositionName.toLowerCase().includes(filterText)) ||
                   (p.DepartmentName && p.DepartmentName.toLowerCase().includes(filterText));
        });

        if (filtered.length === 0) {
            $('#personsList').html('<div class="text-muted p-4 small text-center">هیچ پرسنلی یافت نشد.</div>');
            return;
        }

        filtered.forEach(function(p) {
            var isChecked = selectedPersonIdsSet.has(p.PersonId);
            html += `
            <div class="hover-row p-2 mb-1 rounded ${isChecked ? 'is-checked' : ''}">
                <div class="d-flex align-items-start">
                    <input class="form-check-input chk-person m-0 me-2 mt-1 cursor-pointer flex-shrink-0" 
                           type="checkbox" 
                           value="${p.PersonId}" 
                           id="person_${p.PersonId}" 
                           ${isChecked ? 'checked' : ''}>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="form-check-label cursor-pointer fw-bold text-dark m-0" for="person_${p.PersonId}">
                                ${p.FullName}
                            </label>
                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.68rem;">کد: ${p.PersonelCode}</span>
                        </div>
                        <div class="text-muted small mt-1 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                            <i class="bi bi-briefcase text-secondary"></i>
                            <span>${p.PositionName || p.DepartmentName}</span>
                        </div>
                    </div>
                </div>
            </div>`;
        });

        $('#personsList').html(html);
    }

    function updateDepartmentCount() {
        var count = getSelectedDepartmentIds().length;
        $('#depSelectedCount').text(count + ' دپارتمان');
    }

    function updatePositionCount() {
        var count = getSelectedPositionIds().length;
        $('#posSelectedCount').text(count + ' سمت');
    }

    function updatePersonCount() {
        var count = selectedPersonIdsSet.size;
        $('#personSelectedCount').text(count + ' انتخاب');
        $('#sidebarSelectedCount').text(count + ' نفر');
        $('#audienceSummaryBadge').text(count + ' نفر انتخاب شده');

        // Render hidden inputs for form submission
        var hiddenHtml = '';
        selectedPersonIdsSet.forEach(function(pid) {
            hiddenHtml += `<input type="hidden" name="SelectedPersonIds" value="${pid}" />`;
        });
        $('#selectedPersonHiddenInputs').html(hiddenHtml);
    }

    $(document).ready(function() {
        // Initial question
        addQuestion("میزان رضایت کلی شما از محیط و امکانات کاری چقدر است؟", "Testy", "بسیار زیاد\nزیاد\nمتوسط\nکم\nبسیار کم", true);

        // Load Audience
        loadDepartments();
        loadPositions();

        $('#btnAddQuestion, #btnAddQuestionBottom, #btnFloatingAddQuestion').on('click', function() {
            addQuestion('', 'Testy', 'عالی\nخوب\nمتوسط\nضعیف', true, true);
        });

        $(document).on('click', '.btn-add-next-question', function() {
            addQuestion('', 'Testy', 'عالی\nخوب\nمتوسط\nضعیف', true, true);
        });

        $(document).on('click', '.btn-remove-question', function() {
            if ($('#questionsContainer .question-item').length <= 1) {
                alert('پرسش‌نامه باید حداقل دارای یک سوال باشد.');
                return;
            }
            $(this).closest('.question-item').remove();
            updateQuestionNumbers();
        });

        $(document).on('change', '.select-qtype', function() {
            var selectedType = $(this).val();
            var optionsBox = $(this).closest('.question-item').find('.options-container');

            if (selectedType === 'Tashrihi' || selectedType === 'Boolean') {
                optionsBox.slideUp(200);
            } else {
                optionsBox.slideDown(200);
            }
        });

        // Question Image Upload on File Select
        $(document).on('change', '.question-file-input', function() {
            var fileInput = $(this);
            var files = fileInput[0].files;
            if (!files || files.length === 0) return;

            var file = files[0];
            var parentCard = fileInput.closest('.question-item');
            var hiddenInput = parentCard.find('.question-image-url-input');
            var previewWrapper = parentCard.find('.image-preview-wrapper');
            var imgPreview = parentCard.find('.question-img-preview');
            var uploadBtn = parentCard.find('.btn-upload-image');

            var formData = new FormData();
            formData.append('file', file);
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            uploadBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ارسال...');

            $.ajax({
                url: '@Url.Action("UploadQuestionImage", "Admin")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    uploadBtn.prop('disabled', false).html('<i class="bi bi-cloud-arrow-up me-1"></i> بارگذاری');
                    if (res.success && res.url) {
                        hiddenInput.val(res.url);
                        imgPreview.attr('src', res.url);
                        previewWrapper.removeClass('d-none');
                    } else {
                        alert(res.message || 'خطا در بارگذاری تصویر');
                        fileInput.val('');
                    }
                },
                error: function() {
                    uploadBtn.prop('disabled', false).html('<i class="bi bi-cloud-arrow-up me-1"></i> بارگذاری');
                    alert('خطا در برقراری ارتباط با سرور.');
                    fileInput.val('');
                }
            });
        });

        $(document).on('click', '.btn-upload-image', function() {
            $(this).closest('.question-image-block').find('.question-file-input').trigger('click');
        });

        $(document).on('click', '.btn-delete-image', function() {
            var parentCard = $(this).closest('.question-item');
            parentCard.find('.question-image-url-input').val('');
            parentCard.find('.question-file-input').val('');
            parentCard.find('.image-preview-wrapper').addClass('d-none');
            parentCard.find('.question-img-preview').attr('src', '');
        });

        // Department search filter
        $('#searchDepartmentInput').on('input', function() {
            renderDepartments(allDepartments);
        });

        // Position search filter
        $('#searchPositionInput').on('input', function() {
            renderPositions(allPositions);
        });

        // Row checkbox toggle highlight
        $(document).on('change', '.chk-dep, .chk-pos, .chk-person', function() {
            if ($(this).is(':checked')) {
                $(this).closest('.hover-row').addClass('is-checked');
            } else {
                $(this).closest('.hover-row').removeClass('is-checked');
            }
        });

        // Department checkbox change (Cascades down tree)
        $(document).on('change', '.chk-dep', function() {
            var isChecked = $(this).is(':checked');
            var depId = $(this).val();
            setChildDepartmentsChecked(depId, isChecked);

            updateDepartmentCount();
            loadPositions();
        });

        // All departments
        $('#chkAllDepartments').on('change', function() {
            var checked = $(this).is(':checked');
            $('.chk-dep').prop('checked', checked);
            updateDepartmentCount();
            loadPositions();
        });

        // Position checkbox change
        $(document).on('change', '.chk-pos', function() {
            updatePositionCount();
            loadPersons();
        });

        // All positions
        $('#chkAllPositions').on('change', function() {
            var checked = $(this).is(':checked');
            $('.chk-pos').prop('checked', checked);
            updatePositionCount();
            loadPersons();
        });

        // Person checkbox change
        $(document).on('change', '.chk-person', function() {
            var pid = parseInt($(this).val());
            if ($(this).is(':checked')) {
                selectedPersonIdsSet.add(pid);
            } else {
                selectedPersonIdsSet.delete(pid);
            }
            updatePersonCount();
        });

        // All persons in filtered list
        $('#chkAllPersons').on('change', function() {
            var checked = $(this).is(':checked');
            $('.chk-person').each(function() {
                var pid = parseInt($(this).val());
                $(this).prop('checked', checked);
                if (checked) {
                    selectedPersonIdsSet.add(pid);
                } else {
                    selectedPersonIdsSet.delete(pid);
                }
            });
            updatePersonCount();
        });

        // Search filter
        $('#searchPersonInput').on('input', function() {
            renderPersons(allPersons);
        });

        // Validate on submit
        $('#createForm').on('submit', function(e) {
            if (selectedPersonIdsSet.size === 0) {
                if (!confirm('هیچ پرسنلی برای این پرسش‌نامه انتخاب نشده است. آیا مایلید پرسش‌نامه بدون صدور لینک اولیه ذخیره شود؟')) {
                    e.preventDefault();
                    return false;
                }
            }
        });
    });
</script>
}
