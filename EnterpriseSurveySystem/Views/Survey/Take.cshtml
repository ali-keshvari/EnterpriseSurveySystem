@model EnterpriseSurveySystem.Models.ViewModels.SurveyTakeViewModel
@{
    Layout = "~/Views/Shared/_RespondentLayout.cshtml";
    ViewBag.Title = Model.QuestionnaireTitle;
    ViewBag.TemplateKey = Model.TemplateKey;
}

<div class="container py-2" style="max-width: 800px;">
    <!-- Sticky Timer & Progress Card -->
    <div class="card card-custom mb-4 sticky-top shadow-sm border-primary-subtle" style="top: 15px; z-index: 1020;">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    @if (Model.ShowRespondentName)
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill small">
                            <i class="bi bi-person-badge me-1"></i> @Model.RespondentIdentifier
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1.5 rounded-pill small">
                            <i class="bi bi-shield-check me-1"></i> پاسخ‌دهی محرمانه
                        </span>
                    }
                    <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill small" id="progressText">
                        ۰ از @Model.Questions.Count سوال پاسخ داده شده
                    </span>
                </div>

                @if (Model.TimeLimitMinutes.HasValue && Model.TimeLimitMinutes.Value > 0)
                {
                    <div class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-2 rounded-pill survey-timer-badge d-flex align-items-center gap-1" id="timerBadge">
                        <i class="bi bi-clock-history text-danger fs-6"></i>
                        <span>مهلت باقی‌مانده:</span>
                        <span id="countdownDisplay" class="font-monospace fw-bold">@Model.FormattedTimeRemaining</span>
                    </div>
                }
            </div>

            <!-- Progress bar -->
            <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar bg-primary" id="progressBar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </div>

    <!-- Questionnaire Header Card -->
    <div class="card card-custom p-4 mb-4">
        <h4 class="fw-bold mb-2 text-dark">@Model.QuestionnaireTitle</h4>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="survey-description mb-0" style="line-height: 1.8;">@Model.Description</p>
        }
    </div>

    <!-- Anti-Forgery Token Form -->
    <form id="surveyForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="tokenGuid" value="@Model.TokenGuid" />

        <!-- Questions List -->
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="survey-card question-block" data-qid="@q.Id" data-required="@(q.IsRequired ? "true" : "false")">
                <div class="d-flex align-items-start gap-2 mb-3">
                    <span class="badge bg-primary rounded-pill px-2.5 py-1">@(i + 1)</span>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1 text-dark" style="line-height: 1.7;">
                            @q.QuestionText
                            @if (q.IsRequired)
                            {
                                <span class="text-danger" title="پاسخ الزامی است">*</span>
                            }
                        </h6>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(q.ImageUrl))
                {
                    <div class="mb-3 text-center text-md-start">
                        <a href="@q.ImageUrl" target="_blank" title="مشاهده تصویر بزرگ‌تر در تب جدید">
                            <img src="@q.ImageUrl" alt="@q.QuestionText" class="img-fluid rounded border shadow-sm p-1" style="max-height: 380px; width: auto; object-fit: contain; background: #ffffff;" />
                        </a>
                        <div class="mt-1">
                            <small class="text-muted" style="font-size: 0.72rem;"><i class="bi bi-zoom-in me-1"></i>برای مشاهده تصویر در اندازه اصلی روی آن کلیک فرمایید</small>
                        </div>
                    </div>
                }

                <!-- Question Answer Controls -->
                <div class="answer-container mt-3">
                    @if (q.QuestionType == "Testy")
                    {
                        foreach (var opt in q.Options)
                        {
                            <label class="survey-option-label">
                                <input type="radio" class="form-check-input mt-0 answer-input" name="q_@q.Id" value="@opt" />
                                <span>@opt</span>
                            </label>
                        }
                    }
                    else if (q.QuestionType == "Boolean")
                    {
                        <div class="d-flex gap-3">
                            <label class="survey-option-label mb-0 flex-grow-1 text-center justify-content-center">
                                <input type="radio" class="form-check-input mt-0 answer-input" name="q_@q.Id" value="بله" />
                                <span class="text-success fw-bold">بله</span>
                            </label>
                            <label class="survey-option-label mb-0 flex-grow-1 text-center justify-content-center">
                                <input type="radio" class="form-check-input mt-0 answer-input" name="q_@q.Id" value="خیر" />
                                <span class="text-danger fw-bold">خیر</span>
                            </label>
                        </div>
                    }
                    else if (q.QuestionType == "MultiSelect")
                    {
                        foreach (var opt in q.Options)
                        {
                            <label class="survey-option-label">
                                <input type="checkbox" class="form-check-input mt-0 answer-input multi-check" name="q_@q.Id" value="@opt" />
                                <span>@opt</span>
                            </label>
                        }
                    }
                    else if (q.QuestionType == "Select")
                    {
                        <select class="form-select answer-input" name="q_@q.Id">
                            <option value="">-- لطفاً یک گزینه را انتخاب فرمایید --</option>
                            @foreach (var opt in q.Options)
                            {
                                <option value="@opt">@opt</option>
                            }
                        </select>
                    }
                    else if (q.QuestionType == "Tashrihi")
                    {
                        <textarea class="form-control answer-input" name="q_@q.Id" rows="4" placeholder="دیدگاه یا پاسخ خود را به طور کامل یادداشت فرمایید..."></textarea>
                    }
                </div>
            </div>
        }

        <!-- Submit Button Card -->
        <div class="card card-custom p-4 mb-5 text-center">
            <div class="d-flex flex-column align-items-center gap-2">
                <button type="button" class="btn btn-primary btn-lg px-5 shadow-sm d-flex align-items-center gap-2" id="btnSubmitSurvey">
                    <i class="bi bi-check2-circle fs-5"></i>
                    <span>ثبت نهایی و ارسال پاسخ‌ها</span>
                </button>
                <small class="text-muted">پس از ارسال، لینک یکبارمصرف بسته شده و امکان ویرایش وجود نخواهد داشت.</small>
            </div>
        </div>
    </form>
</div>

@if (Model.TemplateKey == "TypeformFocus")
{
    <!-- Typeform Zen Focus Floating Dock -->
    <div class="position-fixed bottom-0 start-0 end-0 p-3 d-flex justify-content-center" style="z-index: 1040; pointer-events: none;">
        <div class="bg-dark text-white rounded-pill shadow-lg px-4 py-2.5 d-flex align-items-center gap-3 border border-secondary" style="pointer-events: auto; backdrop-filter: blur(16px); background: rgba(15, 23, 42, 0.9) !important;">
            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" id="btnFocusPrev" title="سوال قبلی">
                <i class="bi bi-arrow-up me-1"></i> قبلی
            </button>
            <span class="small font-monospace text-muted px-2" id="focusStepText">۱ از @Model.Questions.Count</span>
            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" id="btnFocusNext" title="سوال بعدی">
                بعدی <i class="bi bi-arrow-down ms-1"></i>
            </button>
            <span class="badge bg-secondary text-white rounded-pill small px-2.5 py-1 d-none d-md-inline-block font-monospace" style="font-size: 0.7rem;">Enter ↵</span>
        </div>
    </div>
}

<!-- Expired Modal -->
<div class="modal fade" id="expiredModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="modal-body">
                <div class="stat-icon bg-danger-subtle text-danger mx-auto mb-3" style="width: 4rem; height: 4rem;">
                    <i class="bi bi-hourglass-bottom fs-2"></i>
                </div>
                <h5 class="fw-bold text-danger mb-2">مهلت زمانی به پایان رسید</h5>
                <p class="text-muted small mb-4">زمان مجاز پاسخ‌گویی به این پرسش‌نامه منقضی شد. دسترسی شما مسدود گردید.</p>
                <a href="@Url.Action("Expired", "Survey", new { token = Model.TokenGuid })" class="btn btn-danger px-4">
                    مشاهده صفحه انقضا
                </a>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var remainingSeconds = @Model.RemainingSeconds;
    var totalQuestions = @Model.Questions.Count;
    var timerInterval = null;

    function formatTime(sec) {
        if (sec <= 0) return "۰۰:۰۰";
        var m = Math.floor(sec / 60);
        var s = sec % 60;
        return (m < 10 ? "۰" + m : m) + ":" + (s < 10 ? "۰" + s : s);
    }

    function startTimer() {
        if (remainingSeconds <= 0) {
            handleTimeExpired();
            return;
        }

        timerInterval = setInterval(function() {
            remainingSeconds--;
            $('#countdownDisplay').text(formatTime(remainingSeconds));

            if (remainingSeconds <= 60) {
                $('#timerBadge').removeClass('bg-warning-subtle text-dark border-warning-subtle').addClass('bg-danger text-white border-danger');
            }

            if (remainingSeconds <= 0) {
                clearInterval(timerInterval);
                handleTimeExpired();
            }
        }, 1000);
    }

    function handleTimeExpired() {
        var modal = new bootstrap.Modal(document.getElementById('expiredModal'));
        modal.show();
        setTimeout(function() {
            window.location.href = '@Url.Action("Expired", "Survey", new { token = Model.TokenGuid })';
        }, 3000);
    }

    function updateProgress() {
        var answeredCount = 0;
        $('.question-block').each(function() {
            var block = $(this);
            var answered = false;

            // Radio
            if (block.find('input[type="radio"]:checked').length > 0) answered = true;
            // Checkbox
            if (block.find('input[type="checkbox"]:checked').length > 0) answered = true;
            // Select
            var selVal = block.find('select').val();
            if (selVal && selVal.trim() !== '') answered = true;
            // Textarea
            var textVal = block.find('textarea').val();
            if (textVal && textVal.trim() !== '') answered = true;

            if (answered) answeredCount++;
        });

        $('#progressText').text(answeredCount + ' از ' + totalQuestions + ' سوال پاسخ داده شده');
        var pct = totalQuestions > 0 ? Math.round((answeredCount / totalQuestions) * 100) : 0;
        $('#progressBar').css('width', pct + '%');
    }

    $(document).ready(function() {
        @if (Model.TimeLimitMinutes.HasValue && Model.TimeLimitMinutes.Value > 0)
        {
            <text>startTimer();</text>
        }

        $(document).on('change input', '.answer-input', function() {
            updateProgress();
            refreshSelectedOptionStyles();
        });

        function refreshSelectedOptionStyles() {
            $('.survey-option-label').each(function() {
                var input = $(this).find('input[type="radio"], input[type="checkbox"]');
                if (input.is(':checked')) {
                    $(this).addClass('is-selected');
                } else {
                    $(this).removeClass('is-selected');
                }
            });
        }
        refreshSelectedOptionStyles();

        @if (Model.TemplateKey == "TypeformFocus")
        {
            <text>
            var currentFocusIndex = 0;
            function updateFocusQuestion(index) {
                var questions = $('.question-block');
                if (index < 0) index = 0;
                if (index >= questions.length) index = questions.length - 1;
                currentFocusIndex = index;

                questions.each(function(i) {
                    if (i === currentFocusIndex) {
                        $(this).addClass('is-focused').css({ 'opacity': '1', 'transform': 'scale(1)', 'filter': 'none', 'transition': 'all 0.25s ease' });
                        $('html, body').animate({
                            scrollTop: $(this).offset().top - 110
                        }, 300);
                    } else {
                        $(this).removeClass('is-focused').css({ 'opacity': '0.88', 'transform': 'scale(0.99)', 'filter': 'none', 'transition': 'all 0.25s ease' });
                    }
                });
                $('#focusStepText').text((currentFocusIndex + 1) + ' از ' + questions.length);
            }

            updateFocusQuestion(0);

            $('#btnFocusNext').on('click', function() {
                updateFocusQuestion(currentFocusIndex + 1);
            });
            $('#btnFocusPrev').on('click', function() {
                updateFocusQuestion(currentFocusIndex - 1);
            });

            // Advance to next question on radio select
            $(document).on('change', '.question-block input[type="radio"]', function() {
                setTimeout(function() {
                    updateFocusQuestion(currentFocusIndex + 1);
                }, 280);
            });

            // Enter key advances
            $(document).on('keydown', function(e) {
                if (e.key === 'Enter' && !$(e.target).is('textarea') && !$(e.target).is('#btnSubmitSurvey')) {
                    e.preventDefault();
                    updateFocusQuestion(currentFocusIndex + 1);
                }
            });
            </text>
        }

        $('#btnSubmitSurvey').on('click', function() {
            // Validate required questions
            var firstMissing = null;
            var missingText = '';

            $('.question-block').each(function(i) {
                var block = $(this);
                var isRequired = block.data('required') === true || block.data('required') === 'true';
                if (!isRequired) return;

                var answered = false;
                if (block.find('input[type="radio"]:checked').length > 0) answered = true;
                if (block.find('input[type="checkbox"]:checked').length > 0) answered = true;
                var sel = block.find('select').val();
                if (sel && sel.trim() !== '') answered = true;
                var txt = block.find('textarea').val();
                if (txt && txt.trim() !== '') answered = true;

                if (!answered && !firstMissing) {
                    firstMissing = block;
                    missingText = 'سوال شماره ' + (i + 1);
                }
            });

            if (firstMissing) {
                alert('لطفاً به ' + missingText + ' که پاسخ به آن الزامی است پاسخ دهید.');
                $('html, body').animate({ scrollTop: firstMissing.offset().top - 120 }, 300);
                firstMissing.addClass('border-danger shadow');
                setTimeout(function() { firstMissing.removeClass('border-danger shadow'); }, 2000);
                return;
            }

            if (!confirm('آیا از ثبت نهایی پاسخ‌های خود اطمینان دارید؟ پس از ارسال، لینک یکبارمصرف بسته خواهد شد.')) {
                return;
            }

            var answers = [];
            $('.question-block').each(function() {
                var block = $(this);
                var qid = parseInt(block.data('qid'));
                var val = '';

                var checkedRadio = block.find('input[type="radio"]:checked');
                if (checkedRadio.length > 0) {
                    val = checkedRadio.val();
                } else {
                    var checks = block.find('input[type="checkbox"]:checked');
                    if (checks.length > 0) {
                        var vals = [];
                        checks.each(function() { vals.push($(this).val()); });
                        val = JSON.stringify(vals);
                    } else if (block.find('select').length > 0) {
                        val = block.find('select').val() || '';
                    } else if (block.find('textarea').length > 0) {
                        val = block.find('textarea').val() || '';
                    }
                }

                if (val && val.trim() !== '') {
                    answers.push({ QuestionId: qid, Value: val.trim() });
                }
            });

            var btn = $('#btnSubmitSurvey');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> در حال ثبت نهایی پاسخ‌ها...');

            var token = $('input[name="__RequestVerificationToken"]').val();
            var payload = {
                TokenGuid: $('#tokenGuid').val(),
                Answers: answers
            };

            $.ajax({
                url: '@Url.Action("Submit", "Survey")',
                type: 'POST',
                data: JSON.stringify(payload),
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(res) {
                    if (res.Success) {
                        window.location.href = res.RedirectUrl || '@Url.Action("Completed", "Survey", new { token = Model.TokenGuid })';
                    } else {
                        alert(res.Message || 'خطا در ثبت پاسخ‌ها.');
                        if (res.RedirectUrl) {
                            window.location.href = res.RedirectUrl;
                        } else {
                            btn.prop('disabled', false).html('<i class="bi bi-check2-circle fs-5"></i> <span>ثبت نهایی و ارسال پاسخ‌ها</span>');
                        }
                    }
                },
                error: function(xhr) {
                    alert('خطا در برقراری ارتباط با سرور.');
                    btn.prop('disabled', false).html('<i class="bi bi-check2-circle fs-5"></i> <span>ثبت نهایی و ارسال پاسخ‌ها</span>');
                }
            });
        });
    });
</script>
}
