@{
    Layout = "~/Views/Shared/_RespondentLayout.cshtml";
    ViewBag.Title = "ثبت موفق پاسخ‌ها";
}

<div class="container" style="max-width: 600px;">
    <div class="card card-custom text-center p-5 shadow-sm">
        <div class="stat-icon bg-success-subtle text-success mx-auto mb-3" style="width: 4.5rem; height: 4.5rem;">
            <i class="bi bi-check2-circle fs-1"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">پاسخ‌های شما با موفقیت ثبت شد</h4>
        <p class="text-muted small mb-4">
            از مشارکت شما در ارزیابی و نظرسنجی سازمانی صمیمانه سپاسگزاریم. مطابق ضوابط امنیتی، این لینک یکبارمصرف اکنون غیرفعال شده است.
        </p>

        <div class="bg-light p-3 rounded-3 border mb-4 text-start small">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">وضعیت دسترسی:</span>
                <span class="text-success fw-bold">تکمیل شده و مختومه</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">زمان ثبت نهایی:</span>
                <span class="font-monospace">@DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss")</span>
            </div>
        </div>

        <div class="d-grid">
            <button class="btn btn-outline-secondary" onclick="window.close();">بستن این صفحه</button>
        </div>
    </div>
</div>
