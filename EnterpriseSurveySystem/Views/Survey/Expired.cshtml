@{
    Layout = "~/Views/Shared/_RespondentLayout.cshtml";
    ViewBag.Title = "مهلت زمانی منقضی شده است";
}

<div class="container" style="max-width: 600px;">
    <div class="card card-custom text-center p-5 shadow-sm border-danger-subtle">
        <div class="stat-icon bg-danger-subtle text-danger mx-auto mb-3" style="width: 4.5rem; height: 4.5rem;">
            <i class="bi bi-clock-history fs-1"></i>
        </div>
        <h4 class="fw-bold text-danger mb-2">مهلت زمانی پاسخ‌گویی به پایان رسیده است</h4>
        <p class="text-muted small mb-4">
            با توجه به پایان محدودیت زمانی مجاز از لحظه اولین ورود، این لینک یکبارمصرف منقضی گردیده و ارسال پاسخ دیگر امکان‌پذیر نمی‌باشد.
        </p>

        <div class="bg-light p-3 rounded-3 border mb-4 text-start small">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">وضعیت توکن:</span>
                <span class="text-danger fw-bold">منقضی شده (TokenExpired)</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">قانون سیستمی:</span>
                <span>محاسبه خودکار انقضا از زمان بازگشایی اولیه</span>
            </div>
        </div>

        <div class="d-grid">
            <button class="btn btn-outline-secondary" onclick="window.close();">بستن پنجره</button>
        </div>
    </div>
</div>
