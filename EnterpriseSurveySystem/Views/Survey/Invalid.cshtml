@{
    Layout = "~/Views/Shared/_RespondentLayout.cshtml";
    ViewBag.Title = "لینک نامعتبر است";
}

<div class="container" style="max-width: 600px;">
    <div class="card card-custom text-center p-5 shadow-sm border-warning-subtle">
        <div class="stat-icon bg-warning-subtle text-warning mx-auto mb-3" style="width: 4.5rem; height: 4.5rem;">
            <i class="bi bi-shield-x fs-1"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">لینک نظرسنجی نامعتبر یا استفاده شده است</h4>
        <p class="text-muted small mb-4">
            توکن ارسالی در سامانه یافت نشد یا این پیوند قبلاً جهت ثبت پاسخ مورد استفاده قرار گرفته است. هر لینک تنها یکبار قابل استفاده می‌باشد.
        </p>

        <div class="bg-light p-3 rounded-3 border mb-4 text-start small">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">علت مسدودسازی:</span>
                <span class="text-warning-emphasis fw-bold">عدم تطابق توکن / ورود مکرر</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">ثبت در سامانه:</span>
                <span class="text-muted">رویداد امنیتی در لاگ سامانه ذخیره شد</span>
            </div>
        </div>

        <div class="d-grid">
            <button class="btn btn-outline-secondary" onclick="window.close();">بستن پنجره</button>
        </div>
    </div>
</div>
