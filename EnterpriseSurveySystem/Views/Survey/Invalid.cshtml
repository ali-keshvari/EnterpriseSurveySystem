@{
    Layout = "~/Views/Shared/_RespondentLayout.cshtml";
    ViewBag.Title = "لینک نامعتبر یا غیرمجاز";
}

<div class="min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white border border-slate-200 rounded-2xl p-8 text-center shadow-lg shadow-slate-100">
        <div class="w-16 h-16 bg-amber-50 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-5 border border-amber-200">
            <span class="material-symbols-outlined text-3xl">link_off</span>
        </div>

        <h1 class="text-xl font-bold text-slate-900 mb-2">لینک نامعتبر یا مسدود شده</h1>
        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
            توکن یا آدرس اینترنتی وارد شده در سیستم یافت نشد یا به دلیل قوانین امنیتی دسترسی به آن غیرمجاز است.
        </p>

        <a href="@Url.Action("Index", "Admin")" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-6 py-2.5 rounded-lg shadow-sm transition">
            <span class="material-symbols-outlined text-base">arrow_forward</span>
            <span>ورود به پنل مدیریت</span>
        </a>
    </div>
</div>
